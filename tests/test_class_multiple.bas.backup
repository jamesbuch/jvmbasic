' Test 5: Multiple classes in one program
' Tests: Multiple CLASS declarations, interaction between classes

CLASS Point
    PUBLIC x AS FLOAT
    PUBLIC y AS FLOAT
    
SUB New(px AS FLOAT As Integer, py AS FLOAT As Integer)
        x = px
        y = py
    END SUB
    
    PUBLIC FUNCTION Distance() AS FLOAT As Integer
        RETURN SQRT(x * x + y * y)
    END FUNCTION
END CLASS

CLASS Circle
    PUBLIC center AS FLOAT
    PUBLIC radius AS FLOAT
    
SUB New(r AS FLOAT As Integer)
        radius = r
        center = 0.0
    END SUB
    
    PUBLIC FUNCTION Area() AS FLOAT As Integer
        RETURN 3.14159 * radius * radius
    END FUNCTION
END CLASS

