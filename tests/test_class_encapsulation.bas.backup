' Test 4: Encapsulation with PRIVATE fields
' Tests: PRIVATE access control, methods accessing private fields

CLASS BankAccount
    PRIVATE balance AS FLOAT
    PUBLIC owner AS STRING
    
SUB New(name AS STRING As Integer, initial AS FLOAT As Integer)
        owner = name
        balance = initial
    END SUB
    
SUB Deposit(amount AS FLOAT As Integer)
        balance = balance + amount
    END SUB
    
    PUBLIC FUNCTION GetBalance() AS FLOAT As Integer
        RETURN balance
    END FUNCTION
END CLASS

