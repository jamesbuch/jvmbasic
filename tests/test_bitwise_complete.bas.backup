Rem Test all bitwise operators - Phase 9 complete

' Test bitwise AND
Dim a As Integer = 5      ' 0101
Dim b As Integer = 3      ' 0011
Dim c As Integer = a & b  ' 0001 = 1
Print "5 & 3 = "; c

' Test bitwise OR
Dim d As Integer = a | b  ' 0111 = 7
Print "5 | 3 = "; d

' Test bitwise XOR
Dim e As Integer = a ^ b  ' 0110 = 6
Print "5 ^ 3 = "; e

' Test shift operators
Dim f As Integer = a << 2  ' 20
Dim g As Integer = a >> 1  ' 2
Print "5 << 2 = "; f
Print "5 >> 1 = "; g

' Test combinations
Dim flags As Integer = (1 | 2 | 4)  ' 7
Print "1 | 2 | 4 = "; flags

Dim mask As Integer = 255 & 15  ' 15
Print "255 & 15 = "; mask

Print "All bitwise operators test complete!"

