FUNCTION sumArrayCustom(arr As IntegerArray, size As Integer)
    total = 0.0
    i = 0.0
    WHILE i < size
        total = total + arr(i)
        i = i + 1.0
    ENDWHILE
    RETURN total
ENDFUNCTION

FUNCTION average(arr As IntegerArray, size As Integer)
    RETURN sumArrayCustom(arr, size) / size
ENDFUNCTION

FUNCTION findMax(arr As IntegerArray, size As Integer)
    maxVal = arr(0)
    i = 1.0
    WHILE i < size
        IF arr(i) > maxVal THEN
            maxVal = arr(i)
        ENDIF
        i = i + 1.0
    ENDWHILE
    RETURN maxVal
ENDFUNCTION

Console.WriteLine("=== Array Parameters - Complete Test ===")
Console.WriteLine("")

DIM data(5) As Integer
data(0) = 12.0
data(1) = 45.0
data(2) = 8.0
data(3) = 33.0
data(4) = 27.0

Console.WriteLine("Array: 12, 45, 8, 33, 27")
Console.WriteLine("Sum: " + sumArrayCustom(data, 5.0))
Console.WriteLine("Average: " + average(data, 5.0))
Console.WriteLine("Max: " + findMax(data, 5.0))
Console.WriteLine("")

Console.WriteLine("=== All Tests Pass! ===")
