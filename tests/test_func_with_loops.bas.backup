FUNCTION factorial(n As Integer)
    result = 1.0
    i = 1.0
    WHILE i <= n
        result = result * i
        i = i + 1.0
    ENDWHILE
    RETURN result
ENDFUNCTION

FUNCTION sumrange(start As Integer, finish As Integer)
    total = 0.0
    FOR i = start TO finish
        total = total + i
    NEXT i
    RETURN total
ENDFUNCTION

Console.WriteLine("Testing functions with loops")

fact5 = factorial(5.0)
Console.WriteLine("factorial(5) = " + fact5)

sum = sumrange(1.0, 10.0)
Console.WriteLine("sum(1 to 10) = " + sum)

