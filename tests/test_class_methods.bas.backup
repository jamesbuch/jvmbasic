' Test 3: CLASS with methods
' Tests: Instance methods, FUNCTION with return type, method calls

CLASS Counter
    PRIVATE count AS FLOAT
    
    PUBLIC SUB New()
        count = 0.0
    END SUB
    
    PUBLIC SUB Increment()
        count = count + 1.0
    END SUB
    
    PUBLIC FUNCTION GetCount() AS FLOAT As Integer
        RETURN count
    END FUNCTION
END CLASS

