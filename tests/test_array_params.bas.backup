FUNCTION sumArrayCustom(arr As IntegerArray, size As Integer)
    total = 0.0
    i = 0.0
    WHILE i < size
        total = total + arr(i)
        i = i + 1.0
    ENDWHILE
    RETURN total
ENDFUNCTION

FUNCTION findMax(arr As IntegerArray, size As Integer)
    maxVal = arr(0)
    i = 1.0
    WHILE i < size
        IF arr(i) > maxVal THEN
            maxVal = arr(i)
        ENDIF
        i = i + 1.0
    ENDWHILE
    RETURN maxVal
ENDFUNCTION

FUNCTION findMin(arr As IntegerArray, size As Integer)
    minVal = arr(0)
    i = 1.0
    WHILE i < size
        IF arr(i) < minVal THEN
            minVal = arr(i)
        ENDIF
        i = i + 1.0
    ENDWHILE
    RETURN minVal
ENDFUNCTION

FUNCTION average(arr As IntegerArray, size As Integer)
    RETURN sumArrayCustom(arr, size) / size
ENDFUNCTION

Console.WriteLine("=== Array Parameter Tests ===")
Console.WriteLine("")

DIM numbers(5) As Integer
numbers(0) = 15.0
numbers(1) = 42.0
numbers(2) = 8.0
numbers(3) = 23.0
numbers(4) = 37.0

Console.WriteLine("Array: 15, 42, 8, 23, 37")
Console.WriteLine("Sum: " + sumArrayCustom(numbers, 5.0))
Console.WriteLine("Max: " + findMax(numbers, 5.0))
Console.WriteLine("Min: " + findMin(numbers, 5.0))
Console.WriteLine("Avg: " + average(numbers, 5.0))
Console.WriteLine("")

DIM scores(4) As Integer
scores(0) = 95.0
scores(1) = 87.0
scores(2) = 92.0
scores(3) = 78.0

Console.WriteLine("Scores: 95, 87, 92, 78")
Console.WriteLine("Total: " + sumArrayCustom(scores, 4.0))
Console.WriteLine("Highest: " + findMax(scores, 4.0))
Console.WriteLine("Lowest: " + findMin(scores, 4.0))
Console.WriteLine("Average: " + average(scores, 4.0))
Console.WriteLine("")

Console.WriteLine("=== All Array Parameter Tests Pass! ===")

