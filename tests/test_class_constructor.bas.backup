' Test 2: CLASS with constructor
' Tests: Constructor declaration (SUB New), constructor parameters

CLASS Point
    PUBLIC x AS FLOAT
    PUBLIC y AS FLOAT
    
SUB New(px AS FLOAT As Integer, py AS FLOAT As Integer)
        x = px
        y = py
    END SUB
END CLASS

