REM Test nested structs
TYPE Point
    x AS FLOAT
    y AS FLOAT
ENDTYPE

TYPE Rectangle
    width AS FLOAT
    height AS FLOAT
ENDTYPE

DIM p AS Point
p.x = 5.0
p.y = 10.0

DIM r AS Rectangle
r.width = 100.0
r.height = 50.0

Console.WriteLine("Point: (" + p).x; ", "; p.y; ")"
Console.WriteLine("Rectangle: " + r).width; "x"; r.height

