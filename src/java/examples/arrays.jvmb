// arrays.jvmb - Test arrays and collections

// ============================================================================
// Integer Array
// ============================================================================

Console.WriteLine("=== Integer Array ===")

var numbers as Integer[] = new Integer[5]
numbers[0] = 10
numbers[1] = 20
numbers[2] = 30
numbers[3] = 40
numbers[4] = 50

Console.Write("Array contents: ")
for i = 0 to 4
    Console.Write(numbers[i].ToString() + " ")
next i
Console.WriteLine("")

// Sum of array
var sum as Integer = 0
for i = 0 to 4
    sum += numbers[i]
next i
Console.WriteLine("Sum: " + sum.ToString())

// ============================================================================
// String Array
// ============================================================================

Console.WriteLine("")
Console.WriteLine("=== String Array ===")

var names as String[] = new String[3]
names[0] = "Alice"
names[1] = "Bob"
names[2] = "Charlie"

Console.WriteLine("Names in array:")
for i = 0 to 2
    Console.WriteLine("  " + i.ToString() + ": " + names[i])
next i

// ============================================================================
// For Each with Array
// ============================================================================

Console.WriteLine("")
Console.WriteLine("=== For Each ===")

Console.WriteLine("Names using for-each:")
for each name in names
    Console.WriteLine("  Hello, " + name + "!")
next name

// ============================================================================
// Array as Function Parameter
// ============================================================================

Console.WriteLine("")
Console.WriteLine("=== Array Functions ===")

function sumArray(arr as Integer[], length as Integer) as Integer
    var total as Integer = 0
    for i = 0 to length - 1
        total += arr[i]
    next i
    return total
end function

function findMax(arr as Integer[], length as Integer) as Integer
    var max as Integer = arr[0]
    for i = 1 to length - 1
        if arr[i] > max then
            max = arr[i]
        end if
    next i
    return max
end function

function findMin(arr as Integer[], length as Integer) as Integer
    var min as Integer = arr[0]
    for i = 1 to length - 1
        if arr[i] < min then
            min = arr[i]
        end if
    next i
    return min
end function

Console.WriteLine("Sum: " + sumArray(numbers, 5).ToString())
Console.WriteLine("Max: " + findMax(numbers, 5).ToString())
Console.WriteLine("Min: " + findMin(numbers, 5).ToString())

// ============================================================================
// Array Initialization and Modification
// ============================================================================

Console.WriteLine("")
Console.WriteLine("=== Array Modification ===")

// Double each element
Console.WriteLine("Original array:")
for i = 0 to 4
    Console.Write(numbers[i].ToString() + " ")
next i
Console.WriteLine("")

for i = 0 to 4
    numbers[i] = numbers[i] * 2
next i

Console.WriteLine("After doubling:")
for i = 0 to 4
    Console.Write(numbers[i].ToString() + " ")
next i
Console.WriteLine("")

// ============================================================================
// Nested Array Access
// ============================================================================

Console.WriteLine("")
Console.WriteLine("=== Complex Array Operations ===")

var data as Integer[] = new Integer[10]
for i = 0 to 9
    data[i] = (i + 1) * 10
next i

// Swap first and last
var temp as Integer = data[0]
data[0] = data[9]
data[9] = temp

Console.WriteLine("After swap (first and last):")
for i = 0 to 9
    Console.Write(data[i].ToString() + " ")
next i
Console.WriteLine("")

// Reverse array
for i = 0 to 4
    temp = data[i]
    data[i] = data[9 - i]
    data[9 - i] = temp
next i

Console.WriteLine("After reverse:")
for i = 0 to 9
    Console.Write(data[i].ToString() + " ")
next i
Console.WriteLine("")

// ============================================================================
// Boolean Array
// ============================================================================

Console.WriteLine("")
Console.WriteLine("=== Boolean Array ===")

var flags as Boolean[] = new Boolean[5]
flags[0] = true
flags[1] = false
flags[2] = true
flags[3] = true
flags[4] = false

var trueCount as Integer = 0
for i = 0 to 4
    if flags[i] then
        trueCount += 1
    end if
next i
Console.WriteLine("True count: " + trueCount.ToString() + " out of 5")
