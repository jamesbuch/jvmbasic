// types.jvmb - Test all primitive types and literals

// Integer types
var intVal as Integer = 42
var longVal as Long = 9223372036854775807L
var byteVal as Byte = 127

// Floating point types
var floatVal as Float = 3.14159F
var doubleVal as Double = 2.718281828459045

// Boolean type
var boolTrue as Boolean = true
var boolFalse as Boolean = false

// Character type
var charVal as Char = 'A'

// String type
var strVal as String = "Hello, World!"
var strWithEscape as String = "Line1\nLine2\tTabbed"
var strWithQuotes as String = "She said \"Hello\""

// Integer literals in different bases
var decimal as Integer = 255
var hex as Integer = 0xFF
var binary as Integer = 0b11111111
var octal as Integer = 0o377

// Long literals
var longHex as Long = 0xFFFFFFFFFL
var longBinary as Long = 0b1010101010101010L

// Output all values
Console.WriteLine("Integer: " & intVal.ToString())
Console.WriteLine("Long: " & longVal.ToString())
Console.WriteLine("Byte: " & byteVal.ToString())
Console.WriteLine("Float: " & floatVal.ToString())
Console.WriteLine("Double: " & doubleVal.ToString())
Console.WriteLine("Boolean true: " & boolTrue.ToString())
Console.WriteLine("Boolean false: " & boolFalse.ToString())
Console.WriteLine("Char: " & charVal.ToString())
Console.WriteLine("String: " & strVal)
Console.WriteLine("Escape: " & strWithEscape)
Console.WriteLine("Hex 0xFF = " & hex.ToString())
Console.WriteLine("Binary 0b11111111 = " & binary.ToString())
Console.WriteLine("Octal 0o377 = " & octal.ToString())
