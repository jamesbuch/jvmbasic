// classes.jvmb - Test classes, inheritance, interfaces, and OOP features

// ============================================================================
// Simple Class
// ============================================================================

public class Point
    private var _x as Integer
    private var _y as Integer

    // Constructor
    public sub new(x as Integer, y as Integer)
        _x = x
        _y = y
    end sub

    // Getters
    public function getX() as Integer
        return _x
    end function

    public function getY() as Integer
        return _y
    end function

    // Method
    public function distanceFromOrigin() as Double
        return Math.Sqrt(_x * _x + _y * _y)
    end function

    public function toString() as String
        return "(" & _x.ToString() & ", " & _y.ToString() & ")"
    end function
end class

// ============================================================================
// Class with Properties
// ============================================================================

public class Person
    private var _name as String
    private var _age as Integer

    public sub new(name as String, age as Integer)
        _name = name
        _age = age
    end sub

    public property Name as String
        get
            return _name
        end get
        set(value as String)
            _name = value
        end set
    end property

    public property Age as Integer
        get
            return _age
        end get
        set(value as Integer)
            if value >= 0 then
                _age = value
            end if
        end set
    end property

    public function greet() as String
        return "Hi, I'm " & _name & " and I'm " & _age.ToString() & " years old"
    end function
end class

// ============================================================================
// Inheritance
// ============================================================================

public class Employee extends Person
    private var _title as String
    private var _salary as Double

    public sub new(name as String, age as Integer, title as String, salary as Double)
        MyBase.new(name, age)
        _title = title
        _salary = salary
    end sub

    public property Title as String
        get
            return _title
        end get
        set(value as String)
            _title = value
        end set
    end property

    public override function greet() as String
        return MyBase.greet() & ". I work as a " & _title
    end function

    public function getAnnualSalary() as Double
        return _salary * 12
    end function
end class

// ============================================================================
// Interface
// ============================================================================

public interface IShape
    function area() as Double
    function perimeter() as Double
end interface

// ============================================================================
// Class implementing interface
// ============================================================================

public class Rectangle implements IShape
    private var _width as Double
    private var _height as Double

    public sub new(width as Double, height as Double)
        _width = width
        _height = height
    end sub

    public function area() as Double
        return _width * _height
    end function

    public function perimeter() as Double
        return 2 * (_width + _height)
    end function

    public function toString() as String
        return "Rectangle(" & _width.ToString() & " x " & _height.ToString() & ")"
    end function
end class

public class Circle implements IShape
    private var _radius as Double

    public sub new(radius as Double)
        _radius = radius
    end sub

    public function area() as Double
        return 3.14159 * _radius * _radius
    end function

    public function perimeter() as Double
        return 2 * 3.14159 * _radius
    end function

    public function toString() as String
        return "Circle(r=" & _radius.ToString() & ")"
    end function
end class

// ============================================================================
// Abstract Class
// ============================================================================

public abstract class Animal
    protected var _name as String

    public sub new(name as String)
        _name = name
    end sub

    public function getName() as String
        return _name
    end function

    // Abstract method - must be overridden
    public function speak() as String
        return ""
    end function
end class

public class Dog extends Animal
    public sub new(name as String)
        MyBase.new(name)
    end sub

    public override function speak() as String
        return _name & " says: Woof!"
    end function
end class

public class Cat extends Animal
    public sub new(name as String)
        MyBase.new(name)
    end sub

    public override function speak() as String
        return _name & " says: Meow!"
    end function
end class

// ============================================================================
// Static/Shared members
// ============================================================================

public class Counter
    shared var _count as Integer = 0

    public sub new()
        _count += 1
    end sub

    shared function getCount() as Integer
        return _count
    end function
end class

// ============================================================================
// Main Program - Test all classes
// ============================================================================

// Test Point
var p as Point = new Point(3, 4)
Console.WriteLine("Point: " & p.toString())
Console.WriteLine("Distance from origin: " & p.distanceFromOrigin().ToString())

// Test Person
var person as Person = new Person("Alice", 30)
Console.WriteLine(person.greet())
person.Name = "Bob"
person.Age = 25
Console.WriteLine(person.greet())

// Test Employee (inheritance)
var emp as Employee = new Employee("Charlie", 35, "Developer", 5000.0)
Console.WriteLine(emp.greet())
Console.WriteLine("Annual salary: $" & emp.getAnnualSalary().ToString())

// Test interface with different shapes
var rect as Rectangle = new Rectangle(10.0, 5.0)
var circle as Circle = new Circle(7.0)

Console.WriteLine(rect.toString() & " - Area: " & rect.area().ToString() & ", Perimeter: " & rect.perimeter().ToString())
Console.WriteLine(circle.toString() & " - Area: " & circle.area().ToString() & ", Perimeter: " & circle.perimeter().ToString())

// Test abstract class and polymorphism
var dog as Dog = new Dog("Buddy")
var cat as Cat = new Cat("Whiskers")
Console.WriteLine(dog.speak())
Console.WriteLine(cat.speak())

// Test static members
var c1 as Counter = new Counter()
var c2 as Counter = new Counter()
var c3 as Counter = new Counter()
Console.WriteLine("Counter instances created: " & Counter.getCount().ToString())
