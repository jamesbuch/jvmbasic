// methods.jvmb - Test method calls and chaining

// ============================================================================
// Console Method Calls
// ============================================================================

Console.WriteLine("=== Console Methods ===")

Console.WriteLine("This is a line")
Console.Write("This is ")
Console.Write("on ")
Console.Write("one ")
Console.WriteLine("line")

// ============================================================================
// String Methods
// ============================================================================

Console.WriteLine("")
Console.WriteLine("=== String Methods ===")

var str as String = "Hello, World!"

Console.WriteLine("Original: " & str)
Console.WriteLine("Length: " & str.Length().ToString())
Console.WriteLine("Upper: " & str.ToUpper())
Console.WriteLine("Lower: " & str.ToLower())
Console.WriteLine("Substring(0,5): " & str.Substring(0, 5))
Console.WriteLine("IndexOf('o'): " & str.IndexOf("o").ToString())
Console.WriteLine("Replace('World','JVM'): " & str.Replace("World", "JVM"))
Console.WriteLine("StartsWith('Hello'): " & str.StartsWith("Hello").ToString())
Console.WriteLine("EndsWith('!'): " & str.EndsWith("!").ToString())
Console.WriteLine("Contains('World'): " & str.Contains("World").ToString())

// ============================================================================
// Method Chaining
// ============================================================================

Console.WriteLine("")
Console.WriteLine("=== Method Chaining ===")

var text as String = "  Hello, World!  "
Console.WriteLine("Original: '" & text & "'")
Console.WriteLine("Trimmed: '" & text.Trim() & "'")
Console.WriteLine("Chained: '" & text.Trim().ToUpper().Replace("WORLD", "BASIC") & "'")

