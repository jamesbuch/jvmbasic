Console.WriteLine("=== Static Methods ===")

Console.WriteLine("Integer.MaxValue: " & Integer.MaxValue.ToString())
Console.WriteLine("Integer.MinValue: " & Integer.MinValue.ToString())
Console.WriteLine("Math.PI: " & Math.PI.ToString())
Console.WriteLine("Math.E: " & Math.E.ToString())

// ============================================================================
// Object Methods
// ============================================================================

Console.WriteLine("")
Console.WriteLine("=== Object Methods ===")

public class Calculator
    private var _value as Integer

    public sub new(initial as Integer)
        _value = initial
    end sub

    public function add(x as Integer) as Calculator
        _value += x
        return me
    end function

    public function subtract(x as Integer) as Calculator
        _value -= x
        return me
    end function

    public function multiply(x as Integer) as Calculator
        _value *= x
        return me
    end function

    public function divide(x as Integer) as Calculator
        _value /= x
        return me
    end function

    public function getValue() as Integer
        return _value
    end function

    public function reset(val as Integer) as Calculator
        _value = val
        return me
    end function
end class

// Fluent interface with method chaining
var calc as Calculator = new Calculator(10)
var result as Integer = calc.add(5).multiply(2).subtract(10).getValue()
Console.WriteLine("10 + 5 * 2 - 10 = " & result.ToString())

calc.reset(100).divide(4).add(25)
Console.WriteLine("100 / 4 + 25 = " & calc.getValue().ToString())

// ============================================================================
// Array Methods via Wrapper
// ============================================================================

Console.WriteLine("")
Console.WriteLine("=== Array-like Operations ===")

public class IntArray
    private var _data as Integer[]
    private var _size as Integer

    public sub new(size as Integer)
        _data = new Integer[size]
        _size = size
    end sub

    public function get(index as Integer) as Integer
        return _data[index]
    end function

    public function set(index as Integer, value as Integer) as IntArray
        _data[index] = value
        return me
    end function

    public function fill(value as Integer) as IntArray
        for i = 0 to _size - 1
            _data[i] = value
        next i
        return me
    end function

    public function sum() as Integer
        var total as Integer = 0
        for i = 0 to _size - 1
            total += _data[i]
        next i
        return total
    end function

    public function toString() as String
        var result as String = "["
        for i = 0 to _size - 1
            if i > 0 then
                result = result & ", "
            end if
            result = result & _data[i].ToString()
        next i
        return result & "]"
    end function
end class

var arr as IntArray = new IntArray(5)
arr.set(0, 10).set(1, 20).set(2, 30).set(3, 40).set(4, 50)
Console.WriteLine("Array: " & arr.toString())
Console.WriteLine("Sum: " & arr.sum().ToString())

arr.fill(7)
Console.WriteLine("Filled: " & arr.toString())

Console.WriteLine("")
Console.WriteLine("All method tests complete!")
