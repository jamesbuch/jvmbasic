; SIR Module: http_test
; ============================================================

; Entry point
static function main(args: Array[elementType=Reference[name=java.lang.String]])
  ; locals: args@0, response@1, length@2, url@3, encoded@4, decoded@5
  entry:
    %0   = SCONST "=== HTTP Namespace Test ==="
    %3   = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %3, java/io/PrintStream.println(%0)
    %4   = SCONST ""
    %7   = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %7, java/io/PrintStream.println(%4)
    %8   = SCONST "Making GET request to httpbin.org..."
    %11  = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %11, java/io/PrintStream.println(%8)
            ; var response
    %12  = SCONST "https://httpbin.org/get"
    %13  = INVOKESTATIC com/jvmbasic/runtime/BasicHttp.Get(%12)
            STORE 1, %13 ; response
    %14  = SCONST "Status: "
    %15  = INVOKESTATIC com/jvmbasic/runtime/BasicHttp.GetStatus()
    %16  = CONCAT %14, %15
    %19  = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %19, java/io/PrintStream.println(%16)
    %20  = SCONST "Success: "
    %21  = INVOKESTATIC com/jvmbasic/runtime/BasicHttp.IsSuccess()
    %22  = CONCAT %20, %21
    %25  = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %25, java/io/PrintStream.println(%22)
    %26  = SCONST ""
    %29  = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %29, java/io/PrintStream.println(%26)
            ; var length
    %30  = LOAD 1 ; response
    %31  = INVOKESTATIC com/jvmbasic/runtime/BasicStr.Length(%30)
            STORE 2, %31 ; length
    %32  = LOAD 2 ; length
    %33  = ICONST 200
    %34  = ICMP_GT %32, %33
            IFFALSE %34, else_1
  then_0:
    %35  = SCONST "Response (first 200 chars):"
    %38  = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %38, java/io/PrintStream.println(%35)
    %39  = LOAD 1 ; response
    %40  = ICONST 0
    %41  = ICONST 200
    %42  = INVOKESTATIC com/jvmbasic/runtime/BasicStr.Substring(%39, %40, %41)
    %45  = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %45, java/io/PrintStream.println(%42)
            GOTO endif_2
  else_1:
    %46  = SCONST "Response:"
    %49  = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %49, java/io/PrintStream.println(%46)
    %50  = LOAD 1 ; response
    %53  = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %53, java/io/PrintStream.println(%50)
            GOTO endif_2
  endif_2:
    %54  = SCONST ""
    %57  = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %57, java/io/PrintStream.println(%54)
            ; var url
    %58  = SCONST "https://httpbin.org/get"
    %59  = SCONST "name"
    %60  = SCONST "Alice"
    %61  = SCONST "age"
    %62  = SCONST "30"
    %63  = INVOKESTATIC com/jvmbasic/runtime/BasicHttp.BuildUrl(%58, %59, %60, %61, %62)
            STORE 3, %63 ; url
    %64  = SCONST "Built URL: "
    %65  = LOAD 3 ; url
    %66  = CONCAT %64, %65
    %69  = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %69, java/io/PrintStream.println(%66)
            ; var encoded
    %70  = SCONST "Hello World!"
    %71  = INVOKESTATIC com/jvmbasic/runtime/BasicHttp.UrlEncode(%70)
            STORE 4, %71 ; encoded
    %72  = SCONST "URL encoded 'Hello World!': "
    %73  = LOAD 4 ; encoded
    %74  = CONCAT %72, %73
    %77  = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %77, java/io/PrintStream.println(%74)
            ; var decoded
    %78  = SCONST "Hello%20World%21"
    %79  = INVOKESTATIC com/jvmbasic/runtime/BasicHttp.UrlDecode(%78)
            STORE 5, %79 ; decoded
    %80  = SCONST "URL decoded 'Hello%20World%21': "
    %81  = LOAD 5 ; decoded
    %82  = CONCAT %80, %81
    %85  = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %85, java/io/PrintStream.println(%82)
    %86  = SCONST ""
    %89  = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %89, java/io/PrintStream.println(%86)
    %90  = SCONST "=== HTTP Test Complete ==="
    %93  = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %93, java/io/PrintStream.println(%90)
            RETURN
end function

