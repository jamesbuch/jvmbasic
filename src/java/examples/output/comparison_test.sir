; SIR Module: comparison_test
; ============================================================

; Entry point
static function main(args: Array[elementType=Reference[name=java.lang.String]])
  ; locals: args@0, a@1, b@2, fa@3, fb@4, da@5, db@7, x@9, y@11
  entry:
    %0   = SCONST "Integer comparisons:"
    %3   = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %3, java/io/PrintStream.println(%0)
            ; var a
    %4   = ICONST 10
            STORE 1, %4 ; a
            ; var b
    %5   = ICONST 20
            STORE 2, %5 ; b
    %6   = LOAD 1 ; a
    %7   = LOAD 2 ; b
    %8   = ICMP_LT %6, %7
            IFFALSE %8, else_1
  then_0:
    %9   = SCONST "10 < 20: true"
    %12  = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %12, java/io/PrintStream.println(%9)
            GOTO endif_2
  else_1:
    %13  = SCONST "10 < 20: false"
    %16  = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %16, java/io/PrintStream.println(%13)
            GOTO endif_2
  endif_2:
    %17  = SCONST "Float comparisons:"
    %20  = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %20, java/io/PrintStream.println(%17)
            ; var fa
    %21  = FCONST 1.5f
            STORE 3, %21 ; fa
            ; var fb
    %22  = FCONST 2.5f
            STORE 4, %22 ; fb
    %23  = LOAD 3 ; fa
    %24  = LOAD 4 ; fb
    %25  = ICMP_LT %23, %24
            IFFALSE %25, else_4
  then_3:
    %26  = SCONST "1.5f < 2.5f: true"
    %29  = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %29, java/io/PrintStream.println(%26)
            GOTO endif_5
  else_4:
    %30  = SCONST "1.5f < 2.5f: false"
    %33  = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %33, java/io/PrintStream.println(%30)
            GOTO endif_5
  endif_5:
    %34  = SCONST "Double comparisons:"
    %37  = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %37, java/io/PrintStream.println(%34)
            ; var da
    %38  = DCONST 3.14159
            STORE 5, %38 ; da
            ; var db
    %39  = DCONST 2.71828
            STORE 7, %39 ; db
    %40  = LOAD 5 ; da
    %41  = LOAD 7 ; db
    %42  = ICMP_GT %40, %41
            IFFALSE %42, else_7
  then_6:
    %43  = SCONST "pi > e: true"
    %46  = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %46, java/io/PrintStream.println(%43)
            GOTO endif_8
  else_7:
    %47  = SCONST "pi > e: false"
    %50  = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %50, java/io/PrintStream.println(%47)
            GOTO endif_8
  endif_8:
    %51  = LOAD 5 ; da
    %52  = LOAD 5 ; da
    %53  = ICMP_GE %51, %52
            IFFALSE %53, else_10
  then_9:
    %54  = SCONST "pi >= pi: true"
    %57  = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %57, java/io/PrintStream.println(%54)
            GOTO endif_11
  else_10:
    %58  = SCONST "pi >= pi: false"
    %61  = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %61, java/io/PrintStream.println(%58)
            GOTO endif_11
  endif_11:
    %62  = SCONST "Epsilon comparison:"
    %65  = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %65, java/io/PrintStream.println(%62)
            ; var x
    %66  = DCONST 0.1
    %67  = DCONST 0.2
    %68  = DADD %66, %67
            STORE 9, %68 ; x
            ; var y
    %69  = DCONST 0.3
            STORE 11, %69 ; y
    %70  = SCONST "0.1 + 0.2 = "
    %71  = LOAD 9 ; x
    %72  = TOSTRING %71
    %73  = CONCAT %70, %72
    %76  = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %76, java/io/PrintStream.println(%73)
    %77  = SCONST "0.3 = "
    %78  = LOAD 11 ; y
    %79  = TOSTRING %78
    %80  = CONCAT %77, %79
    %83  = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %83, java/io/PrintStream.println(%80)
    %84  = LOAD 9 ; x
    %85  = LOAD 11 ; y
    %86  = INVOKESTATIC com/jvmbasic/runtime/BasicMath.ApproxEqual(%84, %85)
            IFFALSE %86, else_13
  then_12:
    %87  = SCONST "Math.ApproxEqual(x, y): true"
    %90  = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %90, java/io/PrintStream.println(%87)
            GOTO endif_14
  else_13:
    %91  = SCONST "Math.ApproxEqual(x, y): false"
    %94  = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %94, java/io/PrintStream.println(%91)
            GOTO endif_14
  endif_14:
    %95  = SCONST "Comparison test complete!"
    %98  = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %98, java/io/PrintStream.println(%95)
            RETURN
end function

