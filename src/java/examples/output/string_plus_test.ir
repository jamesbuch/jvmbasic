CompilationUnit(string_plus_test)
  Statements:
    Console.WriteLine("=== String + Operator Test ===")
    Console.WriteLine("")
    var s1: Reference[name=java.lang.String] = "Hello"
    var s2: Reference[name=java.lang.String] = "World"
    var result1: Reference[name=java.lang.String] = ((s1 CONCAT " ") CONCAT s2)
    Console.WriteLine(("Test 1 (String + String): " CONCAT result1))
    var num: Primitive[kind=INT] = 42
    var result2: Reference[name=java.lang.String] = ("The answer is: " CONCAT num)
    Console.WriteLine(("Test 2 (String + Integer): " CONCAT result2))
    var result3: Reference[name=java.lang.String] = (num CONCAT " is the answer")
    Console.WriteLine(("Test 3 (Integer + String): " CONCAT result3))
    var x: Primitive[kind=INT] = 10
    var y: Primitive[kind=INT] = 20
    var result4: Reference[name=java.lang.String] = ((((("Sum of " CONCAT x) CONCAT " and ") CONCAT y) CONCAT " is ") CONCAT (x ADD y))
    Console.WriteLine(("Test 4 (Multiple concat): " CONCAT result4))
    var result5a: Reference[name=java.lang.String] = ("Using + operator: " CONCAT x)
    var result5b: Reference[name=java.lang.String] = ("Using & operator: " CONCAT x)
    Console.WriteLine(("Test 5a: " CONCAT result5a))
    Console.WriteLine(("Test 5b: " CONCAT result5b))
    var flag: Primitive[kind=BOOLEAN] = true
    var result6: Reference[name=java.lang.String] = ("Flag is " CONCAT flag)
    Console.WriteLine(("Test 6 (Boolean): " CONCAT result6))
    var pi: Primitive[kind=FLOAT] = 3.14F
    var result7: Reference[name=java.lang.String] = ("Pi is approximately " CONCAT pi)
    Console.WriteLine(("Test 7 (Float): " CONCAT result7))
    Console.WriteLine("")
    Console.WriteLine("=== All String + Tests Passed ===")
