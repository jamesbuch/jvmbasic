CompilationUnit(db_test)
  Statements:
    Console.WriteLine("=== Database Namespace Test ===")
    Console.WriteLine("")
    Console.WriteLine("DB functions available:")
    Console.WriteLine("- Db.Connect(url, user, password)")
    Console.WriteLine("- Db.Close()")
    Console.WriteLine("- Db.Query(sql)")
    Console.WriteLine("- Db.Execute(sql)")
    Console.WriteLine("- Db.Prepare(sql)")
    Console.WriteLine("- Db.SetString/SetInt/SetDouble(index, value)")
    Console.WriteLine("- Db.ExecuteQuery()/ExecuteUpdate()")
    Console.WriteLine("- Db.Next()")
    Console.WriteLine("- Db.GetString/GetInt/GetDouble(column)")
    Console.WriteLine("- Db.BeginTransaction/Commit/Rollback()")
    Console.WriteLine("")
    Console.WriteLine("=== Database Test Complete ===")
