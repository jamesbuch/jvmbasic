; SIR Module: minimal
; ============================================================

; Entry point
static function main(args: Array[elementType=Reference[name=java.lang.String]])
  ; locals: args@0, x@1, y@2, z@3
  entry:
            ; var x
    %0   = ICONST 5
            STORE 1, %0 ; x
            ; var y
    %1   = ICONST 10
            STORE 2, %1 ; y
            ; var z
    %2   = LOAD 1 ; x
    %3   = LOAD 2 ; y
    %4   = IADD %2, %3
            STORE 3, %4 ; z
            RETURN
end function

