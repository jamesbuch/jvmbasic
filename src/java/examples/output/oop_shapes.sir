; SIR Module: oop_shapes
; ============================================================

class Point
  field x: Primitive[kind=INT]
  field y: Primitive[kind=INT]

  function <init>(px: Primitive[kind=INT], py: Primitive[kind=INT])
    ; locals: px@1, py@2
    entry:
      %0   = LOAD 1 ; px
      %1   = LOAD 2 ; py
              RETURN
  end function

  function ToString() -> Reference[name=java.lang.String]
    entry:
      %0   = SCONST "("
      %1   = LOAD 0 ; this
      %2   = GETFIELD %1, java/lang/Object.x
      %3   = CONCAT %0, %2
      %4   = SCONST ", "
      %5   = CONCAT %3, %4
      %6   = LOAD 0 ; this
      %7   = GETFIELD %6, java/lang/Object.y
      %8   = CONCAT %5, %7
      %9   = SCONST ")"
      %10  = CONCAT %8, %9
              RETURN %10
  end function
end class

class Rectangle
  field x: Primitive[kind=INT]
  field y: Primitive[kind=INT]
  field width: Primitive[kind=INT]
  field height: Primitive[kind=INT]

  function <init>(px: Primitive[kind=INT], py: Primitive[kind=INT], w: Primitive[kind=INT], h: Primitive[kind=INT])
    ; locals: px@1, py@2, w@3, h@4
    entry:
      %0   = LOAD 1 ; px
      %1   = LOAD 2 ; py
      %2   = LOAD 3 ; w
      %3   = LOAD 4 ; h
              RETURN
  end function

  function Area() -> Primitive[kind=INT]
    entry:
      %0   = LOAD 0 ; this
      %1   = GETFIELD %0, java/lang/Object.width
      %2   = LOAD 0 ; this
      %3   = GETFIELD %2, java/lang/Object.height
      %4   = IMUL %1, %3
              RETURN %4
  end function

  function Perimeter() -> Primitive[kind=INT]
    entry:
      %0   = ICONST 2
      %1   = LOAD 0 ; this
      %2   = GETFIELD %1, java/lang/Object.width
      %3   = LOAD 0 ; this
      %4   = GETFIELD %3, java/lang/Object.height
      %5   = IADD %2, %4
      %6   = IMUL %0, %5
              RETURN %6
  end function

  function IsSquare() -> Primitive[kind=BOOLEAN]
    entry:
      %0   = LOAD 0 ; this
      %1   = GETFIELD %0, java/lang/Object.width
      %2   = LOAD 0 ; this
      %3   = GETFIELD %2, java/lang/Object.height
      %4   = ICMP_EQ %1, %3
              RETURN %4
  end function
end class

; Entry point
static function main(args: Array[elementType=Reference[name=java.lang.String]])
  ; locals: args@0, p1@1, p2@2, rect@3, square@4
  entry:
    %0   = SCONST "=== Geometry Shapes Demo ==="
    %3   = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %3, java/io/PrintStream.println(%0)
    %4   = SCONST ""
    %7   = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %7, java/io/PrintStream.println(%4)
    %8   = SCONST "--- Points ---"
    %11  = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %11, java/io/PrintStream.println(%8)
            ; var p1
    %12  = NEW Point
    %13  = DUP %12
    %14  = ICONST 0
    %15  = ICONST 0
            INVOKESPECIAL %13, Point.<init>(%14, %15)
            STORE 1, %12 ; p1
            ; var p2
    %16  = NEW Point
    %17  = DUP %16
    %18  = ICONST 3
    %19  = ICONST 4
            INVOKESPECIAL %17, Point.<init>(%18, %19)
            STORE 2, %16 ; p2
    %20  = SCONST "Point 1: "
    %21  = LOAD 1 ; p1
    %22  = INVOKEVIRTUAL %21, java/lang/Object.ToString()
    %23  = CONCAT %20, %22
    %26  = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %26, java/io/PrintStream.println(%23)
    %27  = SCONST "Point 2: "
    %28  = LOAD 2 ; p2
    %29  = INVOKEVIRTUAL %28, java/lang/Object.ToString()
    %30  = CONCAT %27, %29
    %33  = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %33, java/io/PrintStream.println(%30)
    %34  = SCONST ""
    %37  = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %37, java/io/PrintStream.println(%34)
    %38  = SCONST "--- Rectangle ---"
    %41  = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %41, java/io/PrintStream.println(%38)
            ; var rect
    %42  = NEW Rectangle
    %43  = DUP %42
    %44  = ICONST 0
    %45  = ICONST 0
    %46  = ICONST 10
    %47  = ICONST 5
            INVOKESPECIAL %43, Rectangle.<init>(%44, %45, %46, %47)
            STORE 3, %42 ; rect
    %48  = SCONST "Rectangle: "
    %49  = LOAD 3 ; rect
    %50  = GETFIELD %49, java/lang/Object.width
    %51  = TOSTRING %50
    %52  = CONCAT %48, %51
    %53  = SCONST " x "
    %54  = CONCAT %52, %53
    %55  = LOAD 3 ; rect
    %56  = GETFIELD %55, java/lang/Object.height
    %57  = TOSTRING %56
    %58  = CONCAT %54, %57
    %61  = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %61, java/io/PrintStream.println(%58)
    %62  = SCONST "Area: "
    %63  = LOAD 3 ; rect
    %64  = INVOKEVIRTUAL %63, java/lang/Object.Area()
    %65  = TOSTRING %64
    %66  = CONCAT %62, %65
    %69  = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %69, java/io/PrintStream.println(%66)
    %70  = SCONST "Perimeter: "
    %71  = LOAD 3 ; rect
    %72  = INVOKEVIRTUAL %71, java/lang/Object.Perimeter()
    %73  = TOSTRING %72
    %74  = CONCAT %70, %73
    %77  = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %77, java/io/PrintStream.println(%74)
    %78  = SCONST "Is Square: "
    %79  = LOAD 3 ; rect
    %80  = INVOKEVIRTUAL %79, java/lang/Object.IsSquare()
    %81  = TOSTRING %80
    %82  = CONCAT %78, %81
    %85  = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %85, java/io/PrintStream.println(%82)
    %86  = SCONST ""
    %89  = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %89, java/io/PrintStream.println(%86)
    %90  = SCONST "--- Square ---"
    %93  = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %93, java/io/PrintStream.println(%90)
            ; var square
    %94  = NEW Rectangle
    %95  = DUP %94
    %96  = ICONST 0
    %97  = ICONST 0
    %98  = ICONST 4
    %99  = ICONST 4
            INVOKESPECIAL %95, Rectangle.<init>(%96, %97, %98, %99)
            STORE 4, %94 ; square
    %100 = SCONST "Square: "
    %101 = LOAD 4 ; square
    %102 = GETFIELD %101, java/lang/Object.width
    %103 = TOSTRING %102
    %104 = CONCAT %100, %103
    %105 = SCONST " x "
    %106 = CONCAT %104, %105
    %107 = LOAD 4 ; square
    %108 = GETFIELD %107, java/lang/Object.height
    %109 = TOSTRING %108
    %110 = CONCAT %106, %109
    %113 = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %113, java/io/PrintStream.println(%110)
    %114 = SCONST "Area: "
    %115 = LOAD 4 ; square
    %116 = INVOKEVIRTUAL %115, java/lang/Object.Area()
    %117 = TOSTRING %116
    %118 = CONCAT %114, %117
    %121 = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %121, java/io/PrintStream.println(%118)
    %122 = SCONST "Is Square: "
    %123 = LOAD 4 ; square
    %124 = INVOKEVIRTUAL %123, java/lang/Object.IsSquare()
    %125 = TOSTRING %124
    %126 = CONCAT %122, %125
    %129 = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %129, java/io/PrintStream.println(%126)
    %130 = SCONST ""
    %133 = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %133, java/io/PrintStream.println(%130)
    %134 = SCONST "=== Geometry Demo Complete ==="
    %137 = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %137, java/io/PrintStream.println(%134)
            RETURN
end function

