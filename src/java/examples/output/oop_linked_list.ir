CompilationUnit(oop_linked_list)
  Classes:
    class Node extends java.lang.Object
  Statements:
    Console.WriteLine("=== Linked List Demo ===")
    Console.WriteLine("")
    var n1: Reference[name=Node] = new Reference[name=Node](10)
    var n2: Reference[name=Node] = new Reference[name=Node](20)
    var n3: Reference[name=Node] = new Reference[name=Node](30)
    n1.hasNext = true
    n2.hasNext = true
    n3.hasNext = false
    Console.WriteLine($"Node 1: value={n1.GetValue()}, hasNext={n1.hasNext}")
    Console.WriteLine($"Node 2: value={n2.GetValue()}, hasNext={n2.hasNext}")
    Console.WriteLine($"Node 3: value={n3.GetValue()}, hasNext={n3.hasNext}")
    Console.WriteLine("")
    Console.WriteLine("Creating additional nodes...")
    var n4: Reference[name=Node] = new Reference[name=Node](40)
    var n5: Reference[name=Node] = new Reference[name=Node](50)
    Console.WriteLine($"Node 4: value={n4.GetValue()}")
    Console.WriteLine($"Node 5: value={n5.GetValue()}")
    Console.WriteLine("")
    Console.WriteLine("=== Linked List Demo Complete ===")
