; SIR Module: float_long_test
; ============================================================

; Entry point
static function main(args: Array[elementType=Reference[name=java.lang.String]])
  ; locals: args@0, f1@1, f2@2, l1@3, l2@5
  entry:
    %0   = SCONST "=== Float Test ==="
    %3   = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %3, java/io/PrintStream.println(%0)
            ; var f1
    %4   = FCONST 1.5f
            STORE 1, %4 ; f1
            ; var f2
    %5   = FCONST 2.5f
            STORE 2, %5 ; f2
    %6   = SCONST "f1 = "
    %9   = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %9, java/io/PrintStream.println(%6)
    %10  = LOAD 1 ; f1
    %13  = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %13, java/io/PrintStream.println(%10)
    %14  = SCONST "f2 = "
    %17  = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %17, java/io/PrintStream.println(%14)
    %18  = LOAD 2 ; f2
    %21  = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %21, java/io/PrintStream.println(%18)
    %22  = SCONST "f1 + f2 = "
    %25  = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %25, java/io/PrintStream.println(%22)
    %26  = LOAD 1 ; f1
    %27  = LOAD 2 ; f2
    %28  = IADD %26, %27
    %31  = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %31, java/io/PrintStream.println(%28)
    %32  = SCONST "f1 * f2 = "
    %35  = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %35, java/io/PrintStream.println(%32)
    %36  = LOAD 1 ; f1
    %37  = LOAD 2 ; f2
    %38  = IMUL %36, %37
    %41  = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %41, java/io/PrintStream.println(%38)
    %42  = SCONST "=== Long Test ==="
    %45  = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %45, java/io/PrintStream.println(%42)
            ; var l1
    %46  = LCONST 1000000000L
            STORE 3, %46 ; l1
            ; var l2
    %47  = LCONST 2000000000L
            STORE 5, %47 ; l2
    %48  = SCONST "l1 = "
    %51  = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %51, java/io/PrintStream.println(%48)
    %52  = LOAD 3 ; l1
    %55  = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %55, java/io/PrintStream.println(%52)
    %56  = SCONST "l2 = "
    %59  = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %59, java/io/PrintStream.println(%56)
    %60  = LOAD 5 ; l2
    %63  = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %63, java/io/PrintStream.println(%60)
    %64  = SCONST "l1 + l2 = "
    %67  = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %67, java/io/PrintStream.println(%64)
    %68  = LOAD 3 ; l1
    %69  = LOAD 5 ; l2
    %70  = IADD %68, %69
    %73  = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %73, java/io/PrintStream.println(%70)
    %74  = SCONST "l1 * 3 = "
    %77  = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %77, java/io/PrintStream.println(%74)
    %78  = LOAD 3 ; l1
    %79  = LCONST 3L
    %80  = IMUL %78, %79
    %83  = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %83, java/io/PrintStream.println(%80)
            RETURN
end function

