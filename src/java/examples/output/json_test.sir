    %137 = CONCAT %133, %136
    %140 = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %140, java/io/PrintStream.println(%137)
    %141 = SCONST ""
    %144 = GETSTATIC java/lang/System.out
