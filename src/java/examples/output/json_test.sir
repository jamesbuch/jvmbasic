    %53  = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %53, java/io/PrintStream.println(%50)
    %54  = SCONST "Active: "
    %55  = LOAD 4 ; active
    %56  = CONCAT %54, %55
    %59  = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %59, java/io/PrintStream.println(%56)
    %60  = SCONST "Has 'name': "
    %61  = LOAD 1 ; json
    %62  = SCONST "name"
    %63  = INVOKESTATIC com/jvmbasic/runtime/BasicJson.Has(%61, %62)
    %64  = CONCAT %60, %63
    %67  = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %67, java/io/PrintStream.println(%64)
    %68  = SCONST "Has 'email': "
