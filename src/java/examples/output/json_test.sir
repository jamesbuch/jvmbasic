            ; var nested
    %154 = INVOKESTATIC com/jvmbasic/runtime/BasicJson.Create()
            STORE 7, %154 ; nested
    %155 = LOAD 7 ; nested
    %156 = SCONST "user"
    %157 = LOAD 5 ; person
    %158 = INVOKESTATIC com/jvmbasic/runtime/BasicJson.SetJson(%155, %156, %157)
            STORE 7, %158 ; nested
    %159 = LOAD 7 ; nested
    %160 = SCONST "fruits"
    %161 = LOAD 6 ; arr
    %162 = INVOKESTATIC com/jvmbasic/runtime/BasicJson.SetJson(%159, %160, %161)
            STORE 7, %162 ; nested
    %163 = SCONST ""
    %166 = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %166, java/io/PrintStream.println(%163)
    %167 = SCONST "Nested JSON:"
    %170 = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %170, java/io/PrintStream.println(%167)
    %171 = LOAD 7 ; nested
    %172 = INVOKESTATIC com/jvmbasic/runtime/BasicJson.Pretty(%171)
    %175 = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %175, java/io/PrintStream.println(%172)
    %176 = SCONST ""
    %179 = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %179, java/io/PrintStream.println(%176)
    %180 = SCONST "Keys count: "
    %181 = LOAD 1 ; json
    %182 = INVOKESTATIC com/jvmbasic/runtime/BasicJson.Length(%181)
    %183 = CONCAT %180, %182
    %186 = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %186, java/io/PrintStream.println(%183)
    %187 = SCONST ""
    %190 = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %190, java/io/PrintStream.println(%187)
    %191 = SCONST "=== JSON Test Complete ==="
    %194 = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %194, java/io/PrintStream.println(%191)
            RETURN
end function

