    %78  = INVOKESTATIC com/jvmbasic/runtime/BasicJson.IsValid(%77)
    %79  = CONCAT %76, %78
    %82  = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %82, java/io/PrintStream.println(%79)
    %83  = SCONST "Is object: "
    %84  = LOAD 1 ; json
    %85  = INVOKESTATIC com/jvmbasic/runtime/BasicJson.IsObject(%84)
    %86  = CONCAT %83, %85
    %89  = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %89, java/io/PrintStream.println(%86)
            ; var person
    %90  = SCONST "firstName"
    %91  = SCONST "Bob"
    %92  = SCONST "lastName"
    %93  = SCONST "Smith"
    %94  = SCONST "score"
    %95  = SCONST "95"
    %96  = INVOKESTATIC com/jvmbasic/runtime/BasicJson.FromPairs(%90, %91, %92, %93, %94, %95)
            STORE 5, %96 ; person
    %97  = SCONST "Person from pairs: "
