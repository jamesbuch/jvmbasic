; SIR Module: json_test
; ============================================================

; Entry point
static function main(args: Array[elementType=Reference[name=java.lang.String]])
  ; locals: args@0, json@1, name@2, age@3, active@4, person@5, arr@6, nested@7
  entry:
    %0   = SCONST "=== JSON Namespace Test ==="
    %3   = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %3, java/io/PrintStream.println(%0)
    %4   = SCONST ""
    %7   = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %7, java/io/PrintStream.println(%4)
            ; var json
    %8   = INVOKESTATIC com/jvmbasic/runtime/BasicJson.Create()
            STORE 1, %8 ; json
    %9   = SCONST "Empty JSON: "
    %10  = LOAD 1 ; json
    %11  = CONCAT %9, %10
    %14  = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %14, java/io/PrintStream.println(%11)
    %15  = LOAD 1 ; json
    %16  = SCONST "name"
    %17  = SCONST "Alice"
    %18  = INVOKESTATIC com/jvmbasic/runtime/BasicJson.Set(%15, %16, %17)
            STORE 1, %18 ; json
    %19  = LOAD 1 ; json
    %20  = SCONST "age"
    %21  = SCONST "30"
    %22  = INVOKESTATIC com/jvmbasic/runtime/BasicJson.Set(%19, %20, %21)
            STORE 1, %22 ; json
    %23  = LOAD 1 ; json
    %24  = SCONST "active"
    %25  = ICONST 1
    %26  = INVOKESTATIC com/jvmbasic/runtime/BasicJson.SetBool(%23, %24, %25)
            STORE 1, %26 ; json
    %27  = SCONST "After setting values: "
    %28  = LOAD 1 ; json
    %29  = CONCAT %27, %28
    %32  = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %32, java/io/PrintStream.println(%29)
            ; var name
    %33  = LOAD 1 ; json
    %34  = SCONST "name"
    %35  = INVOKESTATIC com/jvmbasic/runtime/BasicJson.Get(%33, %34)
            STORE 2, %35 ; name
            ; var age
    %36  = LOAD 1 ; json
    %37  = SCONST "age"
    %38  = INVOKESTATIC com/jvmbasic/runtime/BasicJson.GetInt(%36, %37)
            STORE 3, %38 ; age
            ; var active
