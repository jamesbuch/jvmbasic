    %129 = CONCAT %126, %128
    %132 = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %132, java/io/PrintStream.println(%129)
    %133 = SCONST "Element 1: "
    %134 = LOAD 6 ; arr
