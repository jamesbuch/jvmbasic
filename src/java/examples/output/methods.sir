    %406 = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %406, java/io/PrintStream.println(%403)
    %407 = SCONST ""
    %410 = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %410, java/io/PrintStream.println(%407)
    %411 = SCONST "All method tests complete!"
    %414 = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %414, java/io/PrintStream.println(%411)
            RETURN
end function

