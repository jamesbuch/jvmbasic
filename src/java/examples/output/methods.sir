class Calculator
  field _value: Primitive[kind=INT]

  function <init>(initial: Primitive[kind=INT])
    ; locals: initial@1
    entry:
      %0   = LOAD 1 ; initial
              RETURN
  end function

  function add(x: Primitive[kind=INT]) -> Reference[name=Calculator]
    ; locals: x@1
    entry:
      %0   = LOAD 1 ; x
      %1   = LOAD 0 ; this
              RETURN %1
  end function

  function subtract(x: Primitive[kind=INT]) -> Reference[name=Calculator]
    ; locals: x@1
    entry:
      %0   = LOAD 1 ; x
      %1   = LOAD 0 ; this
              RETURN %1
  end function

  function multiply(x: Primitive[kind=INT]) -> Reference[name=Calculator]
    ; locals: x@1
    entry:
      %0   = LOAD 1 ; x
      %1   = LOAD 0 ; this
              RETURN %1
  end function

  function divide(x: Primitive[kind=INT]) -> Reference[name=Calculator]
    ; locals: x@1
    entry:
      %0   = LOAD 1 ; x
      %1   = LOAD 0 ; this
              RETURN %1
  end function

  function getValue() -> Primitive[kind=INT]
    entry:
              ; unresolved: _value
      %0   = NULL
              RETURN %0
  end function

  function reset(val: Primitive[kind=INT]) -> Reference[name=Calculator]
    ; locals: val@1
    entry:
      %0   = LOAD 1 ; val
      %1   = LOAD 0 ; this
              RETURN %1
  end function
end class

class IntArray
  field _data: Array[elementType=Primitive[kind=INT]]
  field _size: Primitive[kind=INT]

  function <init>(size: Primitive[kind=INT])
    ; locals: size@1
    entry:
