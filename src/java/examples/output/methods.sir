      %2   = ARRAYLOAD %0, %1
              RETURN %2
  end function

  function setItem(index: Primitive[kind=INT], value: Primitive[kind=INT]) -> Reference[name=IntArray]
    ; locals: index@1, value@2
    entry:
      %0   = LOAD 2 ; value
      %1   = LOAD 0 ; this
              RETURN %1
  end function

  function fill(value: Primitive[kind=INT]) -> Reference[name=IntArray]
    ; locals: value@1, i@2
    entry:
              ; for i
      %0   = ICONST 0
              STORE 2, %0 ; i
              GOTO for_cond_0
    for_cond_0:
      %1   = LOAD 2 ; i
              ; unresolved: _size
      %2   = NULL
      %3   = ICONST 1
      %4   = ISUB %2, %3
      %5   = ICMP_LE %1, %4
              IFFALSE %5, for_end_3
    for_body_1:
      %6   = LOAD 1 ; value
              GOTO for_step_2
    for_step_2:
      %7   = LOAD 2 ; i
      %8   = ICONST 1
      %9   = IADD %7, %8
              STORE 2, %9 ; i
              GOTO for_cond_0
    for_end_3:
      %10  = LOAD 0 ; this
              RETURN %10
  end function

  function sum() -> Primitive[kind=INT]
    ; locals: total@1, i@2
    entry:
              ; var total
      %0   = ICONST 0
              STORE 1, %0 ; total
              ; for i
      %1   = ICONST 0
              STORE 2, %1 ; i
              GOTO for_cond_0
    for_cond_0:
      %2   = LOAD 2 ; i
              ; unresolved: _size
      %3   = NULL
      %4   = ICONST 1
      %5   = ISUB %3, %4
      %6   = ICMP_LE %2, %5
              IFFALSE %6, for_end_3
    for_body_1:
              ; unresolved: _data
      %7   = NULL
      %8   = LOAD 2 ; i
      %9   = ARRAYLOAD %7, %8
              STORE 1, %9 ; total
              GOTO for_step_2
    for_step_2:
      %10  = LOAD 2 ; i
      %11  = ICONST 1
      %12  = IADD %10, %11
              STORE 2, %12 ; i
              GOTO for_cond_0
    for_end_3:
      %13  = LOAD 1 ; total
              RETURN %13
  end function

  function toString() -> Reference[name=java.lang.String]
    ; locals: result@1, i@2
    entry:
              ; var result
      %0   = SCONST "["
              STORE 1, %0 ; result
              ; for i
      %1   = ICONST 0
              STORE 2, %1 ; i
              GOTO for_cond_0
    for_cond_0:
      %2   = LOAD 2 ; i
              ; unresolved: _size
      %3   = NULL
      %4   = ICONST 1
      %5   = ISUB %3, %4
      %6   = ICMP_LE %2, %5
              IFFALSE %6, for_end_3
    for_body_1:
      %7   = LOAD 2 ; i
      %8   = ICONST 0
      %9   = ICMP_GT %7, %8
              IFFALSE %9, else_5
    then_4:
      %10  = LOAD 1 ; result
      %11  = SCONST ", "
      %12  = CONCAT %10, %11
              STORE 1, %12 ; result
              GOTO endif_6
    else_5:
              GOTO endif_6
    endif_6:
      %13  = LOAD 1 ; result
              ; unresolved: _data
      %14  = NULL
      %15  = LOAD 2 ; i
      %16  = ARRAYLOAD %14, %15
      %17  = INVOKEVIRTUAL %16, java/lang/Object.ToString()
      %18  = CONCAT %13, %17
              STORE 1, %18 ; result
              GOTO for_step_2
    for_step_2:
      %19  = LOAD 2 ; i
      %20  = ICONST 1
      %21  = IADD %19, %20
              STORE 2, %21 ; i
              GOTO for_cond_0
    for_end_3:
      %22  = LOAD 1 ; result
      %23  = SCONST "]"
