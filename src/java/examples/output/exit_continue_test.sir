  for_step_2:
    %15  = LOAD 1 ; i
    %16  = ICONST 1
    %17  = IADD %15, %16
            STORE 1, %17 ; i
            GOTO for_cond_0
  for_end_3:
    %18  = SCONST "Done with exit for"
    %21  = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %21, java/io/PrintStream.println(%18)
    %22  = SCONST "Continue For test (odd numbers only):"
    %25  = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %25, java/io/PrintStream.println(%22)
            ; for i
    %26  = ICONST 1
            STORE 2, %26 ; i
            GOTO for_cond_7
  for_cond_7:
    %27  = LOAD 2 ; i
    %28  = ICONST 10
    %29  = ICMP_LE %27, %28
            IFFALSE %29, for_end_10
  for_body_8:
    %30  = LOAD 2 ; i
    %31  = ICONST 2
    %32  = IMOD %30, %31
    %33  = ICONST 0
    %34  = ICMP_EQ %32, %33
            IFFALSE %34, else_12
  then_11:
            GOTO endif_13
  else_12:
            GOTO endif_13
  endif_13:
    %35  = LOAD 2 ; i
    %38  = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %38, java/io/PrintStream.println(%35)
            GOTO for_step_9
  for_step_9:
    %39  = LOAD 2 ; i
    %40  = ICONST 1
    %41  = IADD %39, %40
            STORE 2, %41 ; i
            GOTO for_cond_7
  for_end_10:
    %42  = SCONST "Done with continue for"
    %45  = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %45, java/io/PrintStream.println(%42)
    %46  = SCONST "Exit While test:"
    %49  = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %49, java/io/PrintStream.println(%46)
            ; var j
    %50  = ICONST 0
            STORE 3, %50 ; j
            GOTO while_cond_14
  while_cond_14:
    %51  = LOAD 3 ; j
    %52  = ICONST 100
    %53  = ICMP_LT %51, %52
            IFFALSE %53, while_end_16
  while_body_15:
    %54  = LOAD 3 ; j
    %55  = ICONST 1
    %56  = IADD %54, %55
            STORE 3, %56 ; j
    %57  = LOAD 3 ; j
    %58  = ICONST 5
    %59  = ICMP_EQ %57, %58
            IFFALSE %59, else_18
  then_17:
            GOTO endif_19
  else_18:
            GOTO endif_19
  endif_19:
    %60  = LOAD 3 ; j
    %63  = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %63, java/io/PrintStream.println(%60)
            GOTO while_cond_14
  while_end_16:
    %64  = SCONST "Done with exit while"
    %67  = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %67, java/io/PrintStream.println(%64)
    %68  = SCONST "Continue While test (skip 3):"
    %71  = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %71, java/io/PrintStream.println(%68)
            ; var k
    %72  = ICONST 0
            STORE 4, %72 ; k
            GOTO while_cond_20
  while_cond_20:
    %73  = LOAD 4 ; k
    %74  = ICONST 5
    %75  = ICMP_LT %73, %74
            IFFALSE %75, while_end_22
  while_body_21:
    %76  = LOAD 4 ; k
    %77  = ICONST 1
    %78  = IADD %76, %77
            STORE 4, %78 ; k
    %79  = LOAD 4 ; k
    %80  = ICONST 3
    %81  = ICMP_EQ %79, %80
            IFFALSE %81, else_24
  then_23:
            GOTO endif_25
  else_24:
            GOTO endif_25
  endif_25:
    %82  = LOAD 4 ; k
