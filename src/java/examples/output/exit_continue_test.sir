; SIR Module: exit_continue_test
; ============================================================

; Entry point
static function main(args: Array[elementType=Reference[name=java.lang.String]])
  ; locals: args@0, i@2, j@3, k@4
  entry:
    %0   = SCONST "Exit For test:"
    %3   = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %3, java/io/PrintStream.println(%0)
            ; for i
    %4   = ICONST 1
            STORE 1, %4 ; i
            GOTO for_cond_0
  for_cond_0:
    %5   = LOAD 1 ; i
    %6   = ICONST 10
    %7   = ICMP_LE %5, %6
            IFFALSE %7, for_end_3
  for_body_1:
    %8   = LOAD 1 ; i
    %9   = ICONST 5
    %10  = ICMP_EQ %8, %9
            IFFALSE %10, else_5
