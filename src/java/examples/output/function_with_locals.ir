CompilationUnit(function_with_locals)
  Functions:
    Function multiply(x: Primitive[kind=INT], y: Primitive[kind=INT]) -> Primitive[kind=INT]
    Function factorial(n: Primitive[kind=INT]) -> Primitive[kind=INT]
  Statements:
    Console.WriteLine("3 * 4 = ")
    Console.WriteLine(multiply(3, 4))
    Console.WriteLine("factorial(5) = ")
    Console.WriteLine(factorial(5))
    Console.WriteLine("factorial(6) = ")
    Console.WriteLine(factorial(6))
