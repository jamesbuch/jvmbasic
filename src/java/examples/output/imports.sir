; SIR Module: imports
; ============================================================

; Entry point
static function main(args: Array[elementType=Reference[name=java.lang.String]])
  ; locals: args@0, list@1, map@2, now@3, file@4, tempFile@5
  entry:
    %0   = SCONST "=== ArrayList ==="
    %3   = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %3, java/io/PrintStream.println(%0)
            ; var list
    %4   = NEW ArrayList
    %5   = DUP %4
            INVOKESPECIAL %5, ArrayList.<init>()
            STORE 1, %4 ; list
    %6   = LOAD 1 ; list
    %7   = SCONST "First"
    %8   = INVOKEVIRTUAL %6, java/lang/Object.add(%7)
            POP %8
    %9   = LOAD 1 ; list
    %10  = SCONST "Second"
    %11  = INVOKEVIRTUAL %9, java/lang/Object.add(%10)
            POP %11
    %12  = LOAD 1 ; list
    %13  = SCONST "Third"
    %14  = INVOKEVIRTUAL %12, java/lang/Object.add(%13)
            POP %14
    %15  = SCONST "List size: "
    %16  = LOAD 1 ; list
    %17  = INVOKEVIRTUAL %16, java/lang/Object.size()
    %18  = INVOKEVIRTUAL %17, java/lang/Object.ToString()
    %19  = CONCAT %15, %18
    %22  = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %22, java/io/PrintStream.println(%19)
    %23  = SCONST "First item: "
    %24  = LOAD 1 ; list
    %25  = INVOKEVIRTUAL %24, java/lang/Object.toString()
    %26  = CONCAT %23, %25
    %29  = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %29, java/io/PrintStream.println(%26)
    %30  = SCONST "Contains 'Second': "
    %31  = LOAD 1 ; list
    %32  = SCONST "Second"
    %33  = INVOKEVIRTUAL %31, java/lang/Object.contains(%32)
    %34  = INVOKEVIRTUAL %33, java/lang/Object.ToString()
    %35  = CONCAT %30, %34
    %38  = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %38, java/io/PrintStream.println(%35)
    %39  = SCONST "  List contents: "
    %40  = LOAD 1 ; list
    %41  = INVOKEVIRTUAL %40, java/lang/Object.toString()
    %42  = CONCAT %39, %41
    %45  = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %45, java/io/PrintStream.println(%42)
    %46  = SCONST ""
    %49  = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %49, java/io/PrintStream.println(%46)
    %50  = SCONST "=== HashMap ==="
    %53  = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %53, java/io/PrintStream.println(%50)
            ; var map
    %54  = NEW HashMap
    %55  = DUP %54
            INVOKESPECIAL %55, HashMap.<init>()
            STORE 2, %54 ; map
    %56  = LOAD 2 ; map
    %57  = SCONST "name"
    %58  = SCONST "Alice"
    %59  = INVOKEVIRTUAL %56, java/lang/Object.put(%57, %58)
            POP %59
    %60  = LOAD 2 ; map
    %61  = SCONST "age"
    %62  = ICONST 30
    %63  = INVOKEVIRTUAL %60, java/lang/Object.put(%61, %62)
            POP %63
    %64  = LOAD 2 ; map
    %65  = SCONST "city"
    %66  = SCONST "New York"
    %67  = INVOKEVIRTUAL %64, java/lang/Object.put(%65, %66)
            POP %67
    %68  = SCONST "Map size: "
    %69  = LOAD 2 ; map
    %70  = INVOKEVIRTUAL %69, java/lang/Object.size()
    %71  = INVOKEVIRTUAL %70, java/lang/Object.ToString()
    %72  = CONCAT %68, %71
    %75  = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %75, java/io/PrintStream.println(%72)
    %76  = SCONST "Map contents: "
    %77  = LOAD 2 ; map
    %78  = INVOKEVIRTUAL %77, java/lang/Object.toString()
    %79  = CONCAT %76, %78
    %82  = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %82, java/io/PrintStream.println(%79)
    %83  = SCONST "Contains 'name': "
    %84  = LOAD 2 ; map
    %85  = SCONST "name"
    %86  = INVOKEVIRTUAL %84, java/lang/Object.containsKey(%85)
    %87  = INVOKEVIRTUAL %86, java/lang/Object.ToString()
    %88  = CONCAT %83, %87
    %91  = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %91, java/io/PrintStream.println(%88)
    %92  = SCONST ""
    %95  = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %95, java/io/PrintStream.println(%92)
    %96  = SCONST "=== Date ==="
    %99  = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %99, java/io/PrintStream.println(%96)
            ; var now
    %100 = NEW Date
    %101 = DUP %100
            INVOKESPECIAL %101, Date.<init>()
            STORE 3, %100 ; now
    %102 = SCONST "Current time: "
    %103 = LOAD 3 ; now
    %104 = INVOKEVIRTUAL %103, java/lang/Object.toString()
    %105 = CONCAT %102, %104
    %108 = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %108, java/io/PrintStream.println(%105)
    %109 = SCONST "Time in millis: "
    %110 = LOAD 3 ; now
    %111 = INVOKEVIRTUAL %110, java/lang/Object.getTime()
    %112 = INVOKEVIRTUAL %111, java/lang/Object.ToString()
    %113 = CONCAT %109, %112
    %116 = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %116, java/io/PrintStream.println(%113)
    %117 = SCONST ""
    %120 = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %120, java/io/PrintStream.println(%117)
    %121 = SCONST "=== File ==="
    %124 = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %124, java/io/PrintStream.println(%121)
            ; var file
    %125 = NEW File
    %126 = DUP %125
    %127 = SCONST "."
            INVOKESPECIAL %126, File.<init>(%127)
            STORE 4, %125 ; file
    %128 = SCONST "Current directory: "
    %129 = LOAD 4 ; file
    %130 = INVOKEVIRTUAL %129, java/lang/Object.getAbsolutePath()
    %131 = CONCAT %128, %130
    %134 = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %134, java/io/PrintStream.println(%131)
    %135 = SCONST "Exists: "
    %136 = LOAD 4 ; file
    %137 = INVOKEVIRTUAL %136, java/lang/Object.exists()
    %138 = INVOKEVIRTUAL %137, java/lang/Object.ToString()
    %139 = CONCAT %135, %138
    %142 = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %142, java/io/PrintStream.println(%139)
    %143 = SCONST "Is directory: "
    %144 = LOAD 4 ; file
    %145 = INVOKEVIRTUAL %144, java/lang/Object.isDirectory()
    %146 = INVOKEVIRTUAL %145, java/lang/Object.ToString()
    %147 = CONCAT %143, %146
    %150 = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %150, java/io/PrintStream.println(%147)
    %151 = SCONST ""
    %154 = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %154, java/io/PrintStream.println(%151)
    %155 = SCONST "=== Wildcard Import ==="
    %158 = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %158, java/io/PrintStream.println(%155)
            ; var tempFile
    %159 = NEW File
    %160 = DUP %159
    %161 = SCONST "/tmp/test.txt"
            INVOKESPECIAL %160, File.<init>(%161)
            STORE 5, %159 ; tempFile
    %162 = SCONST "Temp file path: "
    %163 = LOAD 5 ; tempFile
    %164 = INVOKEVIRTUAL %163, java/lang/Object.getAbsolutePath()
    %165 = CONCAT %162, %164
    %168 = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %168, java/io/PrintStream.println(%165)
    %169 = SCONST ""
    %172 = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %172, java/io/PrintStream.println(%169)
    %173 = SCONST "All import tests complete!"
    %176 = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %176, java/io/PrintStream.println(%173)
            RETURN
end function

