; SIR Module: oop_linked_list
; ============================================================

class Node
  field value: Primitive[kind=INT]
  field hasNext: Primitive[kind=BOOLEAN]

  function <init>(val: Primitive[kind=INT])
    ; locals: val@1
    entry:
      %0   = LOAD 1 ; val
      %1   = ICONST 0
              RETURN
  end function

  function GetValue() -> Primitive[kind=INT]
    entry:
      %0   = LOAD 0 ; this
      %1   = GETFIELD %0, java/lang/Object.value
              RETURN %1
  end function
end class

; Entry point
static function main(args: Array[elementType=Reference[name=java.lang.String]])
  ; locals: args@0, n1@1, n2@2, n3@3, n4@4, n5@5
  entry:
    %0   = SCONST "=== Linked List Demo ==="
    %3   = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %3, java/io/PrintStream.println(%0)
    %4   = SCONST ""
    %7   = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %7, java/io/PrintStream.println(%4)
            ; var n1
    %8   = NEW Node
    %9   = DUP %8
    %10  = ICONST 10
            INVOKESPECIAL %9, Node.<init>(%10)
            STORE 1, %8 ; n1
            ; var n2
    %11  = NEW Node
    %12  = DUP %11
    %13  = ICONST 20
            INVOKESPECIAL %12, Node.<init>(%13)
            STORE 2, %11 ; n2
            ; var n3
    %14  = NEW Node
    %15  = DUP %14
    %16  = ICONST 30
            INVOKESPECIAL %15, Node.<init>(%16)
            STORE 3, %14 ; n3
    %17  = ICONST 1
    %18  = ICONST 1
    %19  = ICONST 0
    %20  = SCONST "Node 1: value="
    %21  = LOAD 1 ; n1
    %22  = INVOKEVIRTUAL %21, java/lang/Object.GetValue()
    %23  = TOSTRING %22
    %24  = CONCAT %20, %23
    %25  = SCONST ", hasNext="
    %26  = CONCAT %24, %25
    %27  = LOAD 1 ; n1
    %28  = GETFIELD %27, java/lang/Object.hasNext
    %29  = TOSTRING %28
    %30  = CONCAT %26, %29
    %33  = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %33, java/io/PrintStream.println(%30)
    %34  = SCONST "Node 2: value="
    %35  = LOAD 2 ; n2
    %36  = INVOKEVIRTUAL %35, java/lang/Object.GetValue()
    %37  = TOSTRING %36
    %38  = CONCAT %34, %37
    %39  = SCONST ", hasNext="
    %40  = CONCAT %38, %39
    %41  = LOAD 2 ; n2
    %42  = GETFIELD %41, java/lang/Object.hasNext
    %43  = TOSTRING %42
    %44  = CONCAT %40, %43
    %47  = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %47, java/io/PrintStream.println(%44)
    %48  = SCONST "Node 3: value="
    %49  = LOAD 3 ; n3
    %50  = INVOKEVIRTUAL %49, java/lang/Object.GetValue()
    %51  = TOSTRING %50
    %52  = CONCAT %48, %51
    %53  = SCONST ", hasNext="
    %54  = CONCAT %52, %53
    %55  = LOAD 3 ; n3
    %56  = GETFIELD %55, java/lang/Object.hasNext
    %57  = TOSTRING %56
    %58  = CONCAT %54, %57
    %61  = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %61, java/io/PrintStream.println(%58)
    %62  = SCONST ""
    %65  = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %65, java/io/PrintStream.println(%62)
    %66  = SCONST "Creating additional nodes..."
    %69  = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %69, java/io/PrintStream.println(%66)
            ; var n4
    %70  = NEW Node
    %71  = DUP %70
    %72  = ICONST 40
            INVOKESPECIAL %71, Node.<init>(%72)
            STORE 4, %70 ; n4
            ; var n5
    %73  = NEW Node
    %74  = DUP %73
    %75  = ICONST 50
            INVOKESPECIAL %74, Node.<init>(%75)
            STORE 5, %73 ; n5
    %76  = SCONST "Node 4: value="
    %77  = LOAD 4 ; n4
    %78  = INVOKEVIRTUAL %77, java/lang/Object.GetValue()
    %79  = TOSTRING %78
    %80  = CONCAT %76, %79
    %83  = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %83, java/io/PrintStream.println(%80)
    %84  = SCONST "Node 5: value="
    %85  = LOAD 5 ; n5
    %86  = INVOKEVIRTUAL %85, java/lang/Object.GetValue()
    %87  = TOSTRING %86
    %88  = CONCAT %84, %87
    %91  = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %91, java/io/PrintStream.println(%88)
    %92  = SCONST ""
    %95  = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %95, java/io/PrintStream.println(%92)
    %96  = SCONST "=== Linked List Demo Complete ==="
    %99  = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %99, java/io/PrintStream.println(%96)
            RETURN
end function

