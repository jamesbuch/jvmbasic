; SIR Module: functions
; ============================================================

static function factorial(n: Primitive[kind=INT]) -> Primitive[kind=INT]
  ; locals: n@0
  entry:
    %0   = LOAD 0 ; n
    %1   = ICONST 1
    %2   = ICMP_LE %0, %1
            IFFALSE %2, else_1
  then_0:
    %3   = ICONST 1
            RETURN %3
  else_1:
            GOTO endif_2
  endif_2:
    %4   = LOAD 0 ; n
    %5   = LOAD 0 ; n
    %6   = ICONST 1
    %7   = ISUB %5, %6
    %8   = INVOKESTATIC functions.factorial(%7)
    %9   = IMUL %4, %8
            RETURN %9
end function

static function printGreeting(name: Reference[name=java.lang.String])
  ; locals: name@0
  entry:
    %0   = SCONST "Hello, "
    %1   = LOAD 0 ; name
    %2   = TOSTRING %1
    %3   = CONCAT %0, %2
    %4   = SCONST "!"
    %5   = CONCAT %3, %4
    %8   = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %8, java/io/PrintStream.println(%5)
            RETURN
end function

; Entry point
static function main(args: Array[elementType=Reference[name=java.lang.String]])
  ; locals: args@0, result@1, i@2
  entry:
            ; var result
    %0   = ICONST 5
    %1   = INVOKESTATIC functions.factorial(%0)
            STORE 1, %1 ; result
    %2   = SCONST "5! = "
    %3   = LOAD 1 ; result
    %4   = TOSTRING %3
    %5   = CONCAT %2, %4
    %8   = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %8, java/io/PrintStream.println(%5)
    %9   = SCONST "JVM BASIC"
            INVOKESTATIC functions.printGreeting(%9)
            ; var i
    %11  = ICONST 0
            STORE 2, %11 ; i
            GOTO while_cond_0
  while_cond_0:
    %12  = LOAD 2 ; i
    %13  = ICONST 3
    %14  = ICMP_LT %12, %13
            IFFALSE %14, while_end_2
  while_body_1:
    %15  = SCONST "Loop iteration: "
    %16  = LOAD 2 ; i
    %17  = TOSTRING %16
    %18  = CONCAT %15, %17
    %21  = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %21, java/io/PrintStream.println(%18)
    %22  = ICONST 1
            STORE 2, %22 ; i
            GOTO while_cond_0
  while_end_2:
            RETURN
end function

