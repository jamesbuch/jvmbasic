; SIR Module: calculator
; ============================================================

static function Factorial(n: Primitive[kind=INT]) -> Primitive[kind=INT]
  ; locals: n@0, result@1, i@2
  entry:
    %0   = LOAD 0 ; n
    %1   = ICONST 1
    %2   = ICMP_LE %0, %1
            IFFALSE %2, else_1
  then_0:
    %3   = ICONST 1
            RETURN %3
  else_1:
            GOTO endif_2
  endif_2:
            ; var result
    %4   = ICONST 1
            STORE 1, %4 ; result
            ; var i
    %5   = ICONST 2
            STORE 2, %5 ; i
            GOTO while_cond_3
  while_cond_3:
    %6   = LOAD 2 ; i
    %7   = LOAD 0 ; n
    %8   = ICMP_LE %6, %7
            IFFALSE %8, while_end_5
  while_body_4:
    %9   = LOAD 1 ; result
    %10  = LOAD 2 ; i
    %11  = IMUL %9, %10
            STORE 1, %11 ; result
    %12  = LOAD 2 ; i
    %13  = ICONST 1
    %14  = IADD %12, %13
            STORE 2, %14 ; i
            GOTO while_cond_3
  while_end_5:
    %15  = LOAD 1 ; result
            RETURN %15
end function

static function IntPower(base: Primitive[kind=INT], exp: Primitive[kind=INT]) -> Primitive[kind=INT]
  ; locals: base@0, exp@1, result@2, i@3
  entry:
    %0   = LOAD 1 ; exp
    %1   = ICONST 0
    %2   = ICMP_EQ %0, %1
            IFFALSE %2, else_1
  then_0:
    %3   = ICONST 1
            RETURN %3
  else_1:
            GOTO endif_2
  endif_2:
            ; var result
    %4   = ICONST 1
            STORE 2, %4 ; result
            ; var i
    %5   = ICONST 1
            STORE 3, %5 ; i
            GOTO while_cond_3
  while_cond_3:
    %6   = LOAD 3 ; i
    %7   = LOAD 1 ; exp
    %8   = ICMP_LE %6, %7
            IFFALSE %8, while_end_5
  while_body_4:
    %9   = LOAD 2 ; result
    %10  = LOAD 0 ; base
    %11  = IMUL %9, %10
            STORE 2, %11 ; result
    %12  = LOAD 3 ; i
    %13  = ICONST 1
    %14  = IADD %12, %13
            STORE 3, %14 ; i
            GOTO while_cond_3
  while_end_5:
    %15  = LOAD 2 ; result
            RETURN %15
end function

static function IsEven(n: Primitive[kind=INT]) -> Primitive[kind=BOOLEAN]
  ; locals: n@0
  entry:
    %0   = LOAD 0 ; n
    %1   = ICONST 2
    %2   = IMOD %0, %1
    %3   = ICONST 0
    %4   = ICMP_EQ %2, %3
            RETURN %4
end function

static function SumOfDigits(n: Primitive[kind=INT]) -> Primitive[kind=INT]
  ; locals: n@0, sum@1, num@2
  entry:
            ; var sum
    %0   = ICONST 0
            STORE 1, %0 ; sum
            ; var num
    %1   = LOAD 0 ; n
            STORE 2, %1 ; num
    %2   = LOAD 2 ; num
    %3   = ICONST 0
    %4   = ICMP_LT %2, %3
            IFFALSE %4, else_1
  then_0:
    %5   = ICONST 0
    %6   = LOAD 2 ; num
    %7   = ISUB %5, %6
            STORE 2, %7 ; num
            GOTO endif_2
  else_1:
            GOTO endif_2
  endif_2:
            GOTO while_cond_3
  while_cond_3:
    %8   = LOAD 2 ; num
    %9   = ICONST 0
    %10  = ICMP_GT %8, %9
            IFFALSE %10, while_end_5
  while_body_4:
    %11  = LOAD 1 ; sum
    %12  = LOAD 2 ; num
    %13  = ICONST 10
    %14  = IMOD %12, %13
    %15  = IADD %11, %14
            STORE 1, %15 ; sum
    %16  = LOAD 2 ; num
    %17  = ICONST 10
    %18  = IDIV %16, %17
            STORE 2, %18 ; num
            GOTO while_cond_3
  while_end_5:
    %19  = LOAD 1 ; sum
            RETURN %19
end function

static function ReverseNumber(n: Primitive[kind=INT]) -> Primitive[kind=INT]
  ; locals: n@0, reversed@1, num@2
  entry:
            ; var reversed
    %0   = ICONST 0
            STORE 1, %0 ; reversed
            ; var num
    %1   = LOAD 0 ; n
            STORE 2, %1 ; num
            GOTO while_cond_0
  while_cond_0:
    %2   = LOAD 2 ; num
    %3   = ICONST 0
    %4   = ICMP_GT %2, %3
            IFFALSE %4, while_end_2
  while_body_1:
    %5   = LOAD 1 ; reversed
    %6   = ICONST 10
    %7   = IMUL %5, %6
    %8   = LOAD 2 ; num
    %9   = ICONST 10
    %10  = IMOD %8, %9
    %11  = IADD %7, %10
            STORE 1, %11 ; reversed
    %12  = LOAD 2 ; num
    %13  = ICONST 10
    %14  = IDIV %12, %13
            STORE 2, %14 ; num
            GOTO while_cond_0
  while_end_2:
    %15  = LOAD 1 ; reversed
            RETURN %15
end function

; Entry point
static function main(args: Array[elementType=Reference[name=java.lang.String]])
  ; locals: args@0, a@1, b@2
  entry:
    %0   = SCONST "=== Calculator Demo ==="
    %3   = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %3, java/io/PrintStream.println(%0)
    %4   = SCONST ""
    %7   = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %7, java/io/PrintStream.println(%4)
    %8   = SCONST "--- Basic Operations ---"
    %11  = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %11, java/io/PrintStream.println(%8)
            ; var a
    %12  = ICONST 15
            STORE 1, %12 ; a
            ; var b
    %13  = ICONST 4
            STORE 2, %13 ; b
    %14  = SCONST "a = "
    %15  = LOAD 1 ; a
    %16  = TOSTRING %15
    %17  = CONCAT %14, %16
    %18  = SCONST ", b = "
    %19  = CONCAT %17, %18
    %20  = LOAD 2 ; b
    %21  = TOSTRING %20
    %22  = CONCAT %19, %21
    %25  = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %25, java/io/PrintStream.println(%22)
    %26  = SCONST "a + b = "
    %27  = LOAD 1 ; a
    %28  = LOAD 2 ; b
    %29  = IADD %27, %28
    %30  = TOSTRING %29
    %31  = CONCAT %26, %30
    %34  = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %34, java/io/PrintStream.println(%31)
    %35  = SCONST "a - b = "
    %36  = LOAD 1 ; a
    %37  = LOAD 2 ; b
    %38  = ISUB %36, %37
    %39  = TOSTRING %38
    %40  = CONCAT %35, %39
    %43  = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %43, java/io/PrintStream.println(%40)
    %44  = SCONST "a * b = "
    %45  = LOAD 1 ; a
    %46  = LOAD 2 ; b
    %47  = IMUL %45, %46
    %48  = TOSTRING %47
    %49  = CONCAT %44, %48
    %52  = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %52, java/io/PrintStream.println(%49)
    %53  = SCONST "a / b = "
    %54  = LOAD 1 ; a
    %55  = LOAD 2 ; b
    %56  = IDIV %54, %55
    %57  = TOSTRING %56
    %58  = CONCAT %53, %57
    %61  = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %61, java/io/PrintStream.println(%58)
    %62  = SCONST "a mod b = "
    %63  = LOAD 1 ; a
    %64  = LOAD 2 ; b
    %65  = IMOD %63, %64
    %66  = TOSTRING %65
    %67  = CONCAT %62, %66
    %70  = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %70, java/io/PrintStream.println(%67)
    %71  = SCONST ""
    %74  = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %74, java/io/PrintStream.println(%71)
    %75  = SCONST "--- Powers ---"
    %78  = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %78, java/io/PrintStream.println(%75)
    %79  = SCONST "2^10 = "
    %80  = ICONST 2
    %81  = ICONST 10
    %82  = INVOKESTATIC calculator.IntPower(%80, %81)
    %83  = TOSTRING %82
    %84  = CONCAT %79, %83
    %87  = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %87, java/io/PrintStream.println(%84)
    %88  = SCONST "3^4 = "
    %89  = ICONST 3
    %90  = ICONST 4
    %91  = INVOKESTATIC calculator.IntPower(%89, %90)
    %92  = TOSTRING %91
    %93  = CONCAT %88, %92
    %96  = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %96, java/io/PrintStream.println(%93)
    %97  = SCONST "5^3 = "
    %98  = ICONST 5
    %99  = ICONST 3
    %100 = INVOKESTATIC calculator.IntPower(%98, %99)
    %101 = TOSTRING %100
    %102 = CONCAT %97, %101
    %105 = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %105, java/io/PrintStream.println(%102)
    %106 = SCONST ""
    %109 = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %109, java/io/PrintStream.println(%106)
    %110 = SCONST "--- Factorials ---"
    %113 = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %113, java/io/PrintStream.println(%110)
    %114 = SCONST "5! = "
    %115 = ICONST 5
    %116 = INVOKESTATIC calculator.Factorial(%115)
    %117 = TOSTRING %116
    %118 = CONCAT %114, %117
    %121 = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %121, java/io/PrintStream.println(%118)
    %122 = SCONST "7! = "
    %123 = ICONST 7
    %124 = INVOKESTATIC calculator.Factorial(%123)
    %125 = TOSTRING %124
    %126 = CONCAT %122, %125
    %129 = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %129, java/io/PrintStream.println(%126)
    %130 = SCONST "10! = "
    %131 = ICONST 10
    %132 = INVOKESTATIC calculator.Factorial(%131)
    %133 = TOSTRING %132
    %134 = CONCAT %130, %133
    %137 = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %137, java/io/PrintStream.println(%134)
    %138 = SCONST ""
    %141 = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %141, java/io/PrintStream.println(%138)
    %142 = SCONST "--- Even/Odd Check ---"
    %145 = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %145, java/io/PrintStream.println(%142)
    %146 = SCONST "Is 10 even? "
    %147 = ICONST 10
    %148 = INVOKESTATIC calculator.IsEven(%147)
    %149 = TOSTRING %148
    %150 = CONCAT %146, %149
    %153 = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %153, java/io/PrintStream.println(%150)
    %154 = SCONST "Is 7 even? "
    %155 = ICONST 7
    %156 = INVOKESTATIC calculator.IsEven(%155)
    %157 = TOSTRING %156
    %158 = CONCAT %154, %157
    %161 = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %161, java/io/PrintStream.println(%158)
    %162 = SCONST "Is 0 even? "
    %163 = ICONST 0
    %164 = INVOKESTATIC calculator.IsEven(%163)
    %165 = TOSTRING %164
    %166 = CONCAT %162, %165
    %169 = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %169, java/io/PrintStream.println(%166)
    %170 = SCONST ""
    %173 = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %173, java/io/PrintStream.println(%170)
    %174 = SCONST "--- Sum of Digits ---"
    %177 = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %177, java/io/PrintStream.println(%174)
    %178 = SCONST "Sum of digits of 12345: "
    %179 = ICONST 12345
    %180 = INVOKESTATIC calculator.SumOfDigits(%179)
    %181 = TOSTRING %180
    %182 = CONCAT %178, %181
    %185 = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %185, java/io/PrintStream.println(%182)
    %186 = SCONST "Sum of digits of 9876: "
    %187 = ICONST 9876
    %188 = INVOKESTATIC calculator.SumOfDigits(%187)
    %189 = TOSTRING %188
    %190 = CONCAT %186, %189
    %193 = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %193, java/io/PrintStream.println(%190)
    %194 = SCONST ""
    %197 = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %197, java/io/PrintStream.println(%194)
    %198 = SCONST "--- Reverse Number ---"
    %201 = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %201, java/io/PrintStream.println(%198)
    %202 = SCONST "Reverse of 12345: "
    %203 = ICONST 12345
    %204 = INVOKESTATIC calculator.ReverseNumber(%203)
    %205 = TOSTRING %204
    %206 = CONCAT %202, %205
    %209 = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %209, java/io/PrintStream.println(%206)
    %210 = SCONST "Reverse of 9876: "
    %211 = ICONST 9876
    %212 = INVOKESTATIC calculator.ReverseNumber(%211)
    %213 = TOSTRING %212
    %214 = CONCAT %210, %213
    %217 = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %217, java/io/PrintStream.println(%214)
    %218 = SCONST ""
    %221 = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %221, java/io/PrintStream.println(%218)
    %222 = SCONST "=== Calculator Demo Complete ==="
    %225 = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %225, java/io/PrintStream.println(%222)
            RETURN
end function

