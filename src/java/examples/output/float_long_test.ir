CompilationUnit(float_long_test)
  Statements:
    Console.WriteLine("=== Float Test ===")
    var f1: Primitive[kind=FLOAT] = 1.5F
    var f2: Primitive[kind=FLOAT] = 2.5F
    Console.WriteLine("f1 = ")
    Console.WriteLine(f1)
    Console.WriteLine("f2 = ")
    Console.WriteLine(f2)
    Console.WriteLine("f1 + f2 = ")
    Console.WriteLine((f1 ADD f2))
    Console.WriteLine("f1 * f2 = ")
    Console.WriteLine((f1 MUL f2))
    Console.WriteLine("=== Long Test ===")
    var l1: Primitive[kind=LONG] = 1000000000L
    var l2: Primitive[kind=LONG] = 2000000000L
    Console.WriteLine("l1 = ")
    Console.WriteLine(l1)
    Console.WriteLine("l2 = ")
    Console.WriteLine(l2)
    Console.WriteLine("l1 + l2 = ")
    Console.WriteLine((l1 ADD l2))
    Console.WriteLine("l1 * 3 = ")
    Console.WriteLine((l1 MUL 3L))
