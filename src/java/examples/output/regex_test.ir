CompilationUnit(regex_test)
  Statements:
    Console.WriteLine("Regex namespace test:")
    Console.WriteLine("IsMatch test:")
    if (Regex.IsMatch("hello123", "[a-z]+[0-9]+")) { ... }
    Console.WriteLine("Contains test:")
    if (Regex.Contains("The quick brown fox", "quick")) { ... }
    Console.WriteLine("Email validation:")
    if (Regex.IsEmail("test@example.com")) { ... }
    if (Regex.IsEmail("not-an-email")) { ... }
    Console.WriteLine("Replace test:")
    var text: Reference[name=java.lang.String] = "foo bar foo baz"
    Console.WriteLine(Regex.ReplaceAll(text, "foo", "replaced"))
    Console.WriteLine("Find test:")
    var input: Reference[name=java.lang.String] = "abc123def456"
    Console.WriteLine(Regex.Find(input, "[0-9]+"))
    Console.WriteLine("Count test:")
    Console.WriteLine(Regex.Count(input, "[0-9]+"))
    Console.WriteLine("IsDigitsOnly test:")
    if (Regex.IsDigitsOnly("12345")) { ... }
    Console.WriteLine("Regex test complete!")
