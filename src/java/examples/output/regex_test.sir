; SIR Module: regex_test
; ============================================================

; Entry point
static function main(args: Array[elementType=Reference[name=java.lang.String]])
  ; locals: args@0, text@1, input@2
  entry:
    %0   = SCONST "Regex namespace test:"
    %3   = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %3, java/io/PrintStream.println(%0)
    %4   = SCONST "IsMatch test:"
    %7   = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %7, java/io/PrintStream.println(%4)
    %8   = SCONST "hello123"
    %9   = SCONST "[a-z]+[0-9]+"
    %10  = INVOKESTATIC com/jvmbasic/runtime/BasicRegex.IsMatch(%8, %9)
            IFFALSE %10, else_1
  then_0:
    %11  = SCONST "Matched!"
    %14  = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %14, java/io/PrintStream.println(%11)
            GOTO endif_2
  else_1:
    %15  = SCONST "No match"
    %18  = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %18, java/io/PrintStream.println(%15)
            GOTO endif_2
  endif_2:
    %19  = SCONST "Contains test:"
    %22  = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %22, java/io/PrintStream.println(%19)
    %23  = SCONST "The quick brown fox"
    %24  = SCONST "quick"
    %25  = INVOKESTATIC com/jvmbasic/runtime/BasicRegex.Contains(%23, %24)
            IFFALSE %25, else_4
  then_3:
    %26  = SCONST "Found quick!"
    %29  = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %29, java/io/PrintStream.println(%26)
            GOTO endif_5
  else_4:
    %30  = SCONST "Not found"
    %33  = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %33, java/io/PrintStream.println(%30)
            GOTO endif_5
  endif_5:
    %34  = SCONST "Email validation:"
    %37  = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %37, java/io/PrintStream.println(%34)
    %38  = SCONST "test@example.com"
    %39  = INVOKESTATIC com/jvmbasic/runtime/BasicRegex.IsEmail(%38)
            IFFALSE %39, else_7
  then_6:
    %40  = SCONST "Valid email"
    %43  = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %43, java/io/PrintStream.println(%40)
            GOTO endif_8
  else_7:
    %44  = SCONST "Invalid email"
    %47  = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %47, java/io/PrintStream.println(%44)
            GOTO endif_8
  endif_8:
    %48  = SCONST "not-an-email"
    %49  = INVOKESTATIC com/jvmbasic/runtime/BasicRegex.IsEmail(%48)
            IFFALSE %49, else_10
  then_9:
    %50  = SCONST "Valid email"
    %53  = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %53, java/io/PrintStream.println(%50)
            GOTO endif_11
  else_10:
    %54  = SCONST "Invalid email"
    %57  = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %57, java/io/PrintStream.println(%54)
            GOTO endif_11
  endif_11:
    %58  = SCONST "Replace test:"
    %61  = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %61, java/io/PrintStream.println(%58)
            ; var text
    %62  = SCONST "foo bar foo baz"
            STORE 1, %62 ; text
    %63  = LOAD 1 ; text
    %64  = SCONST "foo"
    %65  = SCONST "replaced"
    %66  = INVOKESTATIC com/jvmbasic/runtime/BasicRegex.ReplaceAll(%63, %64, %65)
    %69  = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %69, java/io/PrintStream.println(%66)
    %70  = SCONST "Find test:"
    %73  = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %73, java/io/PrintStream.println(%70)
            ; var input
    %74  = SCONST "abc123def456"
            STORE 2, %74 ; input
    %75  = LOAD 2 ; input
    %76  = SCONST "[0-9]+"
    %77  = INVOKESTATIC com/jvmbasic/runtime/BasicRegex.Find(%75, %76)
    %80  = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %80, java/io/PrintStream.println(%77)
    %81  = SCONST "Count test:"
    %84  = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %84, java/io/PrintStream.println(%81)
    %85  = LOAD 2 ; input
    %86  = SCONST "[0-9]+"
    %87  = INVOKESTATIC com/jvmbasic/runtime/BasicRegex.Count(%85, %86)
    %90  = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %90, java/io/PrintStream.println(%87)
    %91  = SCONST "IsDigitsOnly test:"
    %94  = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %94, java/io/PrintStream.println(%91)
    %95  = SCONST "12345"
    %96  = INVOKESTATIC com/jvmbasic/runtime/BasicRegex.IsDigitsOnly(%95)
            IFFALSE %96, else_13
  then_12:
    %97  = SCONST "Only digits"
    %100 = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %100, java/io/PrintStream.println(%97)
            GOTO endif_14
  else_13:
    %101 = SCONST "Not only digits"
    %104 = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %104, java/io/PrintStream.println(%101)
            GOTO endif_14
  endif_14:
    %105 = SCONST "Regex test complete!"
    %108 = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %108, java/io/PrintStream.println(%105)
            RETURN
end function

