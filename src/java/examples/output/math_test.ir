CompilationUnit(math_test)
  Statements:
    Console.WriteLine("Math namespace test:")
    Console.WriteLine("Pi:")
    Console.WriteLine(Math.Pi())
    Console.WriteLine("E:")
    Console.WriteLine(Math.E())
    Console.WriteLine("Sqrt(16):")
    Console.WriteLine(Math.Sqrt(16.0F))
    Console.WriteLine("Pow(2, 8):")
    Console.WriteLine(Math.Pow(2.0F, 8.0F))
    Console.WriteLine("Sin(0):")
    Console.WriteLine(Math.Sin(0.0F))
    Console.WriteLine("Cos(0):")
    Console.WriteLine(Math.Cos(0.0F))
    Console.WriteLine("Floor(3.7):")
    Console.WriteLine(Math.Floor(3.7F))
    Console.WriteLine("Ceil(3.2):")
    Console.WriteLine(Math.Ceil(3.2F))
    Console.WriteLine("Min(5, 3):")
    Console.WriteLine(Math.Min(5.0F, 3.0F))
    Console.WriteLine("Max(5, 3):")
    Console.WriteLine(Math.Max(5.0F, 3.0F))
    Console.WriteLine("Random (0-1):")
    Console.WriteLine(Math.Random())
    Console.WriteLine("Math test complete!")
