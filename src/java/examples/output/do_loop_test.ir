CompilationUnit(do_loop_test)
  Statements:
    Console.WriteLine("=== DO WHILE test ===")
    var i: Primitive[kind=INT] = 1
    while ((i LE 5)) { ... }
    Console.WriteLine("Done!")
    Console.WriteLine("=== DO UNTIL test ===")
    i = 1
    while ((NOT (i GT 5))) { ... }
    Console.WriteLine("Done!")
    Console.WriteLine("=== DO ... LOOP WHILE test ===")
    i = 1
    while ((i LE 5)) { ... }
    Console.WriteLine("Done!")
    Console.WriteLine("=== DO ... LOOP UNTIL test ===")
    i = 1
    while ((NOT (i GT 5))) { ... }
    Console.WriteLine("Done!")
