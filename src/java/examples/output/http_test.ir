CompilationUnit(http_test)
  Statements:
    Console.WriteLine("=== HTTP Namespace Test ===")
    Console.WriteLine("")
    Console.WriteLine("Making GET request to httpbin.org...")
    var response: Reference[name=java.lang.String] = Http.Get("https://httpbin.org/get")
    Console.WriteLine(("Status: " CONCAT Http.GetStatus()))
    Console.WriteLine(("Success: " CONCAT Http.IsSuccess()))
    Console.WriteLine("")
    var length: Primitive[kind=INT] = Str.Length(response)
    if ((length GT 200)) { ... }
    Console.WriteLine("")
    var url: Reference[name=java.lang.String] = Http.BuildUrl("https://httpbin.org/get", "name", "Alice", "age", "30")
    Console.WriteLine(("Built URL: " CONCAT url))
    var encoded: Reference[name=java.lang.String] = Http.UrlEncode("Hello World!")
    Console.WriteLine(("URL encoded 'Hello World!': " CONCAT encoded))
    var decoded: Reference[name=java.lang.String] = Http.UrlDecode("Hello%20World%21")
    Console.WriteLine(("URL decoded 'Hello%20World%21': " CONCAT decoded))
    Console.WriteLine("")
    Console.WriteLine("=== HTTP Test Complete ===")
