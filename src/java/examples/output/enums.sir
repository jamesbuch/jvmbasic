; SIR Module: enums
; ============================================================

class Task
  field _name: Reference[name=java.lang.String]
  field _priority: Reference[name=Priority]

  function <init>(name: Reference[name=java.lang.String], priority: Reference[name=Priority])
    ; locals: name@1, priority@2
    entry:
      %0   = LOAD 1 ; name
      %1   = LOAD 2 ; priority
              RETURN
  end function

  function getPriority() -> Reference[name=Priority]
    entry:
              ; unresolved: _priority
      %0   = NULL
              RETURN %0
  end function

  function isUrgent() -> Primitive[kind=BOOLEAN]
    entry:
              ; unresolved: _priority
      %0   = NULL
              ; unresolved: Priority
      %1   = NULL
      %2   = GETFIELD %1, java/lang/Object.High
      %3   = ICMP_EQ %0, %2
              ; unresolved: _priority
      %4   = NULL
              ; unresolved: Priority
      %5   = NULL
      %6   = GETFIELD %5, java/lang/Object.Critical
      %7   = ICMP_EQ %4, %6
      %8   = IOR %3, %7
              RETURN %8
  end function

  function toString() -> Reference[name=java.lang.String]
    entry:
              ; unresolved: _name
      %0   = NULL
      %1   = SCONST " ["
      %2   = CONCAT %0, %1
              ; unresolved: _priority
      %3   = NULL
      %4   = INVOKEVIRTUAL %3, java/lang/Object.ToString()
      %5   = CONCAT %2, %4
      %6   = SCONST "]"
      %7   = CONCAT %5, %6
              RETURN %7
  end function
end class

static function getColorName(c: Reference[name=Color]) -> Reference[name=java.lang.String]
  ; locals: c@0
  entry:
    %0   = LOAD 0 ; c
            ; unresolved: Color
    %1   = NULL
    %2   = GETFIELD %1, java/lang/Object.Red
    %3   = ICMP_EQ %0, %2
            IFFALSE %3, else_1
  then_0:
    %4   = SCONST "Crimson"
            RETURN %4
  else_1:
    %5   = SCONST "Unknown"
            RETURN %5
  endif_2:
    %6   = NULL
            RETURN %6
end function

static function getSizePrice(s: Reference[name=Size]) -> Primitive[kind=DOUBLE]
