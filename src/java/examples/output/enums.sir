            RETURN %4
  else_1:
    %5   = LOAD 0 ; s
            ; unresolved: Size
    %6   = NULL
    %7   = GETFIELD %6, java/lang/Object.Medium
    %8   = ICMP_EQ %5, %7
            IFFALSE %8, else_4
  then_3:
    %9   = FCONST 14.99f
            RETURN %9
  else_4:
    %10  = LOAD 0 ; s
            ; unresolved: Size
    %11  = NULL
    %12  = GETFIELD %11, java/lang/Object.Large
    %13  = ICMP_EQ %10, %12
            IFFALSE %13, else_7
  then_6:
    %14  = FCONST 19.99f
            RETURN %14
  else_7:
    %15  = LOAD 0 ; s
            ; unresolved: Size
    %16  = NULL
    %17  = GETFIELD %16, java/lang/Object.ExtraLarge
    %18  = ICMP_EQ %15, %17
            IFFALSE %18, else_10
  then_9:
    %19  = FCONST 24.99f
            RETURN %19
  else_10:
    %20  = FCONST 0.0f
            RETURN %20
  endif_11:
            GOTO endif_8
  endif_8:
            GOTO endif_5
  endif_5:
            GOTO endif_2
  endif_2:
    %21  = DCONST 0.0
            RETURN %21
end function

static function getStatusMessage(status: Reference[name=HttpStatus]) -> Reference[name=java.lang.String]
  ; locals: status@0
  entry:
    %0   = LOAD 0 ; status
            ; unresolved: HttpStatus
    %1   = NULL
    %2   = GETFIELD %1, java/lang/Object.OK
    %3   = ICMP_EQ %0, %2
            IFFALSE %3, else_1
  then_0:
    %4   = SCONST "Success"
            RETURN %4
  else_1:
    %5   = LOAD 0 ; status
            ; unresolved: HttpStatus
    %6   = NULL
    %7   = GETFIELD %6, java/lang/Object.Created
    %8   = ICMP_EQ %5, %7
            IFFALSE %8, else_4
  then_3:
    %9   = SCONST "Resource created"
            RETURN %9
  else_4:
    %10  = LOAD 0 ; status
            ; unresolved: HttpStatus
    %11  = NULL
    %12  = GETFIELD %11, java/lang/Object.BadRequest
    %13  = ICMP_EQ %10, %12
            IFFALSE %13, else_7
  then_6:
    %14  = SCONST "Invalid request"
            RETURN %14
  else_7:
    %15  = LOAD 0 ; status
            ; unresolved: HttpStatus
    %16  = NULL
    %17  = GETFIELD %16, java/lang/Object.NotFound
    %18  = ICMP_EQ %15, %17
            IFFALSE %18, else_10
  then_9:
    %19  = SCONST "Resource not found"
            RETURN %19
  else_10:
    %20  = LOAD 0 ; status
            ; unresolved: HttpStatus
    %21  = NULL
    %22  = GETFIELD %21, java/lang/Object.InternalError
    %23  = ICMP_EQ %20, %22
            IFFALSE %23, else_13
  then_12:
    %24  = SCONST "Server error"
            RETURN %24
  else_13:
    %25  = SCONST "Unknown status"
            RETURN %25
  endif_14:
            GOTO endif_11
  endif_11:
            GOTO endif_8
  endif_8:
            GOTO endif_5
  endif_5:
            GOTO endif_2
  endif_2:
    %26  = NULL
            RETURN %26
end function

