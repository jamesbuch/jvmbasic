CompilationUnit(nullables)
  Functions:
    Function greet(name: Nullable[wrapped=Reference[name=java.lang.String]]) -> Reference[name=java.lang.String]
    Function findName(id: Primitive[kind=INT]) -> Nullable[wrapped=Reference[name=java.lang.String]]
    Function safeDivide(a: Primitive[kind=INT], b: Nullable[wrapped=Primitive[kind=INT]]) -> Nullable[wrapped=Primitive[kind=INT]]
  Classes:
    class OptionalValue extends java.lang.Object
  Statements:
    Console.WriteLine("=== Nullable String ===")
    var maybeString: Nullable[wrapped=Reference[name=java.lang.String]] = nil
    if ((maybeString EQ nil)) { ... }
    maybeString = "Hello"
    if ((maybeString NE nil)) { ... }
    Console.WriteLine("")
    Console.WriteLine("=== Nullable Integer ===")
    var maybeInt: Nullable[wrapped=Primitive[kind=INT]] = nil
    if ((maybeInt EQ nil)) { ... }
    maybeInt = 42
    if ((maybeInt NE nil)) { ... }
    Console.WriteLine("")
    Console.WriteLine("=== Nullable Parameters ===")
    Console.WriteLine(greet(nil))
    Console.WriteLine(greet("Alice"))
    Console.WriteLine(greet(nil))
    Console.WriteLine(greet("Bob"))
    Console.WriteLine("")
    Console.WriteLine("=== Nullable Return Type ===")
    for i = 1 to 5 { ... }
    Console.WriteLine("")
    Console.WriteLine("=== Nullable in Class ===")
    var opt: Reference[name=OptionalValue] = new Reference[name=OptionalValue]("Score")
    Console.WriteLine(opt.toString())
    Console.WriteLine($"Has value: {opt.hasValue()}")
    opt.setValue(100)
    Console.WriteLine(opt.toString())
    Console.WriteLine($"Has value: {opt.hasValue()}")
    opt.clearValue()
    Console.WriteLine(opt.toString())
    Console.WriteLine("")
    Console.WriteLine("=== Chained Null Checks ===")
    var result1: Nullable[wrapped=Primitive[kind=INT]] = safeDivide(10, 2)
    var result2: Nullable[wrapped=Primitive[kind=INT]] = safeDivide(10, 0)
    var result3: Nullable[wrapped=Primitive[kind=INT]] = safeDivide(10, nil)
    Console.WriteLine($"10 / 2 = {(result1 EQ nil)}")
    Console.WriteLine($"10 / 0 = {(result2 EQ nil)}")
    Console.WriteLine($"10 / Nil = {(result3 EQ nil)}")
    Console.WriteLine("")
    Console.WriteLine("All nullable tests complete!")
