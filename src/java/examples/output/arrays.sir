static function sumArray(arr: Array[elementType=Primitive[kind=INT]], length: Primitive[kind=INT]) -> Primitive[kind=INT]
  ; locals: arr@0, length@1, total@2, i@3
  entry:
            ; var total
    %0   = ICONST 0
            STORE 2, %0 ; total
            ; for i
    %1   = ICONST 0
            STORE 3, %1 ; i
            GOTO for_cond_0
  for_cond_0:
    %2   = LOAD 3 ; i
    %3   = LOAD 1 ; length
    %4   = ICONST 1
    %5   = ISUB %3, %4
    %6   = ICMP_LE %2, %5
            IFFALSE %6, for_end_3
  for_body_1:
    %7   = LOAD 0 ; arr
    %8   = LOAD 3 ; i
    %9   = ARRAYLOAD %7, %8
            STORE 2, %9 ; total
            GOTO for_step_2
  for_step_2:
    %10  = LOAD 3 ; i
    %11  = ICONST 1
    %12  = IADD %10, %11
            STORE 3, %12 ; i
            GOTO for_cond_0
  for_end_3:
    %13  = LOAD 2 ; total
            RETURN %13
end function

static function findMax(arr: Array[elementType=Primitive[kind=INT]], length: Primitive[kind=INT]) -> Primitive[kind=INT]
  ; locals: arr@0, length@1, max@2, i@3
  entry:
            ; var max
    %0   = LOAD 0 ; arr
    %1   = ICONST 0
    %2   = ARRAYLOAD %0, %1
            STORE 2, %2 ; max
            ; for i
    %3   = ICONST 1
            STORE 3, %3 ; i
            GOTO for_cond_0
  for_cond_0:
    %4   = LOAD 3 ; i
    %5   = LOAD 1 ; length
    %6   = ICONST 1
    %7   = ISUB %5, %6
    %8   = ICMP_LE %4, %7
            IFFALSE %8, for_end_3
  for_body_1:
    %9   = LOAD 0 ; arr
    %10  = LOAD 3 ; i
    %11  = ARRAYLOAD %9, %10
    %12  = LOAD 2 ; max
    %13  = ICMP_GT %11, %12
            IFFALSE %13, else_5
  then_4:
    %14  = LOAD 0 ; arr
    %15  = LOAD 3 ; i
    %16  = ARRAYLOAD %14, %15
            STORE 2, %16 ; max
            GOTO endif_6
  else_5:
            GOTO endif_6
  endif_6:
            GOTO for_step_2
  for_step_2:
    %17  = LOAD 3 ; i
    %18  = ICONST 1
    %19  = IADD %17, %18
            STORE 3, %19 ; i
            GOTO for_cond_0
  for_end_3:
    %20  = LOAD 2 ; max
            RETURN %20
end function

static function findMin(arr: Array[elementType=Primitive[kind=INT]], length: Primitive[kind=INT]) -> Primitive[kind=INT]
  ; locals: arr@0, length@1, min@2, i@3
  entry:
            ; var min
    %0   = LOAD 0 ; arr
    %1   = ICONST 0
    %2   = ARRAYLOAD %0, %1
            STORE 2, %2 ; min
            ; for i
    %3   = ICONST 1
            STORE 3, %3 ; i
            GOTO for_cond_0
  for_cond_0:
    %4   = LOAD 3 ; i
    %5   = LOAD 1 ; length
    %6   = ICONST 1
    %7   = ISUB %5, %6
    %8   = ICMP_LE %4, %7
            IFFALSE %8, for_end_3
  for_body_1:
    %9   = LOAD 0 ; arr
    %10  = LOAD 3 ; i
    %11  = ARRAYLOAD %9, %10
    %12  = LOAD 2 ; min
    %13  = ICMP_LT %11, %12
            IFFALSE %13, else_5
  then_4:
    %14  = LOAD 0 ; arr
    %15  = LOAD 3 ; i
    %16  = ARRAYLOAD %14, %15
            STORE 2, %16 ; min
            GOTO endif_6
  else_5:
            GOTO endif_6
  endif_6:
            GOTO for_step_2
  for_step_2:
    %17  = LOAD 3 ; i
    %18  = ICONST 1
    %19  = IADD %17, %18
            STORE 3, %19 ; i
            GOTO for_cond_0
  for_end_3:
    %20  = LOAD 2 ; min
            RETURN %20
end function

