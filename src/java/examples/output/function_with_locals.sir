; SIR Module: function_with_locals
; ============================================================

static function multiply(x: Primitive[kind=INT], y: Primitive[kind=INT]) -> Primitive[kind=INT]
  ; locals: x@0, y@1, result@2
  entry:
            ; var result
    %0   = LOAD 0 ; x
    %1   = LOAD 1 ; y
    %2   = IMUL %0, %1
            STORE 2, %2 ; result
    %3   = LOAD 2 ; result
            RETURN %3
end function

static function factorial(n: Primitive[kind=INT]) -> Primitive[kind=INT]
  ; locals: n@0
  entry:
    %0   = LOAD 0 ; n
    %1   = ICONST 1
    %2   = ICMP_LE %0, %1
            IFFALSE %2, else_1
  then_0:
    %3   = ICONST 1
            RETURN %3
  else_1:
            GOTO endif_2
  endif_2:
    %4   = LOAD 0 ; n
    %5   = LOAD 0 ; n
    %6   = ICONST 1
    %7   = ISUB %5, %6
    %8   = INVOKESTATIC function_with_locals.factorial(%7)
    %9   = IMUL %4, %8
            RETURN %9
end function

; Entry point
static function main(args: Array[elementType=Reference[name=java.lang.String]])
  ; locals: args@0
  entry:
    %0   = SCONST "3 * 4 = "
    %3   = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %3, java/io/PrintStream.println(%0)
    %4   = ICONST 3
    %5   = ICONST 4
    %6   = INVOKESTATIC function_with_locals.multiply(%4, %5)
    %9   = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %9, java/io/PrintStream.println(%6)
    %10  = SCONST "factorial(5) = "
    %13  = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %13, java/io/PrintStream.println(%10)
    %14  = ICONST 5
    %15  = INVOKESTATIC function_with_locals.factorial(%14)
    %18  = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %18, java/io/PrintStream.println(%15)
    %19  = SCONST "factorial(6) = "
    %22  = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %22, java/io/PrintStream.println(%19)
    %23  = ICONST 6
    %24  = INVOKESTATIC function_with_locals.factorial(%23)
    %27  = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %27, java/io/PrintStream.println(%24)
            RETURN
end function

