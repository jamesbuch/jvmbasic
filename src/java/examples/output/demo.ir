CompilationUnit(demo)
  Statements:
    var x: Primitive[kind=INT] = 10
    var y: Primitive[kind=INT] = 25
    var sum: Primitive[kind=INT] = (x ADD y)
    var diff: Primitive[kind=INT] = (y SUB x)
    var product: Primitive[kind=INT] = (x MUL y)
    var quotient: Primitive[kind=INT] = (y DIV x)
    Console.WriteLine("=== JVM BASIC 2.0 Demo ===")
    Console.WriteLine("x = 10, y = 25")
    Console.WriteLine("sum (x + y):")
    Console.WriteLine(sum)
    Console.WriteLine("difference (y - x):")
    Console.WriteLine(diff)
    Console.WriteLine("product (x * y):")
    Console.WriteLine(product)
    Console.WriteLine("quotient (y / x):")
    Console.WriteLine(quotient)
    Console.WriteLine("")
    Console.WriteLine("=== Conditionals ===")
    if ((sum GT 30)) { ... }
    Console.WriteLine("")
    Console.WriteLine("=== While Loop (countdown from 5) ===")
    var count: Primitive[kind=INT] = 5
    while ((count GT 0)) { ... }
    Console.WriteLine("Liftoff!")
    Console.WriteLine("")
    Console.WriteLine("=== Demo Complete ===")
