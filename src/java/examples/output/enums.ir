CompilationUnit(enums)
  Functions:
    Function getColorName(c: Reference[name=Color]) -> Reference[name=java.lang.String]
    Function getSizePrice(s: Reference[name=Size]) -> Primitive[kind=DOUBLE]
    Function getStatusMessage(status: Reference[name=HttpStatus]) -> Reference[name=java.lang.String]
  Classes:
    class Task extends java.lang.Object
  Statements:
    Console.WriteLine("=== Basic Enum Usage ===")
    var myColor: Reference[name=Color] = Color.Blue
    var mySize: Reference[name=Size] = Size.Large
    Console.WriteLine(("Color: " CONCAT myColor.ToString()))
    Console.WriteLine(("Size: " CONCAT mySize.ToString()))
    Console.WriteLine("")
    Console.WriteLine("=== Enum in Conditions ===")
    Console.WriteLine(("Red is called: " CONCAT getColorName(Color.Red)))
    Console.WriteLine(("Blue is called: " CONCAT getColorName(Color.Blue)))
    Console.WriteLine("")
    Console.WriteLine("=== Enum in Select Case ===")
    Console.WriteLine(("Small: $" CONCAT getSizePrice(Size.Small).ToString()))
    Console.WriteLine(("Medium: $" CONCAT getSizePrice(Size.Medium).ToString()))
    Console.WriteLine(("Large: $" CONCAT getSizePrice(Size.Large).ToString()))
    Console.WriteLine(("ExtraLarge: $" CONCAT getSizePrice(Size.ExtraLarge).ToString()))
    Console.WriteLine("")
    Console.WriteLine("=== Enum with Values ===")
    Console.WriteLine(("200: " CONCAT getStatusMessage(HttpStatus.OK)))
    Console.WriteLine(("404: " CONCAT getStatusMessage(HttpStatus.NotFound)))
    Console.WriteLine(("500: " CONCAT getStatusMessage(HttpStatus.InternalError)))
    Console.WriteLine("")
    Console.WriteLine("=== Enum in Class ===")
    var task1: Reference[name=Task] = new Reference[name=Task]("Write docs", Priority.Low)
    var task2: Reference[name=Task] = new Reference[name=Task]("Fix bug", Priority.High)
    var task3: Reference[name=Task] = new Reference[name=Task]("Security patch", Priority.Critical)
    Console.WriteLine(((task1.toString() CONCAT " - Urgent: ") CONCAT task1.isUrgent().ToString()))
    Console.WriteLine(((task2.toString() CONCAT " - Urgent: ") CONCAT task2.isUrgent().ToString()))
    Console.WriteLine(((task3.toString() CONCAT " - Urgent: ") CONCAT task3.isUrgent().ToString()))
    Console.WriteLine("")
    Console.WriteLine("All enum tests complete!")
