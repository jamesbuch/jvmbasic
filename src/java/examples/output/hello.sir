; SIR Module: hello
; ============================================================

; Entry point
static function main(args: Array[elementType=Reference[name=java.lang.String]])
  ; locals: args@0, message@1, count@2, i@3
  entry:
            ; var message
    %0   = SCONST "Hello, World!"
            STORE 1, %0 ; message
            ; var count
    %1   = ICONST 5
            STORE 2, %1 ; count
            ; for i
    %2   = ICONST 1
            STORE 3, %2 ; i
            GOTO for_cond_0
  for_cond_0:
    %3   = LOAD 3 ; i
    %4   = LOAD 2 ; count
    %5   = ICMP_LE %3, %4
            IFFALSE %5, for_end_3
  for_body_1:
    %6   = LOAD 1 ; message
    %9   = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %9, java/io/PrintStream.println(%6)
            GOTO for_step_2
  for_step_2:
    %10  = LOAD 3 ; i
    %11  = ICONST 1
    %12  = IADD %10, %11
            STORE 3, %12 ; i
            GOTO for_cond_0
  for_end_3:
    %13  = SCONST "Done!"
    %16  = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %16, java/io/PrintStream.println(%13)
            RETURN
end function

