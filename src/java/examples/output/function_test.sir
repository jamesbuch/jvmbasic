; SIR Module: function_test
; ============================================================

static function add(a: Primitive[kind=INT], b: Primitive[kind=INT]) -> Primitive[kind=INT]
  ; locals: a@0, b@1
  entry:
    %0   = LOAD 0 ; a
    %1   = LOAD 1 ; b
    %2   = IADD %0, %1
            RETURN %2
end function

; Entry point
static function main(args: Array[elementType=Reference[name=java.lang.String]])
  ; locals: args@0, result@1
  entry:
            ; var result
    %0   = ICONST 5
    %1   = ICONST 3
    %2   = INVOKESTATIC function_test.add(%0, %1)
            STORE 1, %2 ; result
    %3   = SCONST "5 + 3 = "
    %6   = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %6, java/io/PrintStream.println(%3)
    %7   = LOAD 1 ; result
    %10  = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %10, java/io/PrintStream.println(%7)
    %11  = SCONST "10 + 20 = "
    %14  = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %14, java/io/PrintStream.println(%11)
    %15  = ICONST 10
    %16  = ICONST 20
    %17  = INVOKESTATIC function_test.add(%15, %16)
    %20  = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %20, java/io/PrintStream.println(%17)
            RETURN
end function

