; SIR Module: class_test
; ============================================================

class Person
  field name: Reference[name=java.lang.String]
  field age: Primitive[kind=INT]

  function <init>(n: Reference[name=java.lang.String], a: Primitive[kind=INT])
    ; locals: n@1, a@2
    entry:
      %0   = LOAD 1 ; n
      %1   = LOAD 2 ; a
              RETURN
  end function

  function Greet() -> Reference[name=java.lang.String]
    entry:
      %0   = SCONST "Hello, I am "
      %1   = LOAD 0 ; this
      %2   = GETFIELD %1, java/lang/Object.name
      %3   = CONCAT %0, %2
              RETURN %3
  end function

  function IsOlderThan(other: Reference[name=Person]) -> Primitive[kind=BOOLEAN]
    ; locals: other@1
    entry:
      %0   = LOAD 0 ; this
      %1   = GETFIELD %0, java/lang/Object.age
      %2   = LOAD 1 ; other
      %3   = GETFIELD %2, java/lang/Object.age
      %4   = ICMP_GT %1, %3
              RETURN %4
  end function
end class

; Entry point
static function main(args: Array[elementType=Reference[name=java.lang.String]])
  ; locals: args@0, alice@1, bob@2
  entry:
    %0   = SCONST "=== OOP Class Test ==="
    %3   = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %3, java/io/PrintStream.println(%0)
    %4   = SCONST ""
    %7   = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %7, java/io/PrintStream.println(%4)
            ; var alice
    %8   = NEW Person
    %9   = DUP %8
    %10  = SCONST "Alice"
    %11  = ICONST 30
            INVOKESPECIAL %9, Person.<init>(%10, %11)
            STORE 1, %8 ; alice
            ; var bob
    %12  = NEW Person
    %13  = DUP %12
    %14  = SCONST "Bob"
    %15  = ICONST 25
            INVOKESPECIAL %13, Person.<init>(%14, %15)
            STORE 2, %12 ; bob
    %16  = SCONST "Alice: "
    %17  = LOAD 1 ; alice
    %18  = GETFIELD %17, java/lang/Object.name
    %19  = CONCAT %16, %18
    %20  = SCONST ", age "
    %21  = CONCAT %19, %20
    %22  = LOAD 1 ; alice
    %23  = GETFIELD %22, java/lang/Object.age
    %24  = CONCAT %21, %23
    %27  = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %27, java/io/PrintStream.println(%24)
    %28  = SCONST "Bob: "
    %29  = LOAD 2 ; bob
    %30  = GETFIELD %29, java/lang/Object.name
    %31  = CONCAT %28, %30
    %32  = SCONST ", age "
    %33  = CONCAT %31, %32
    %34  = LOAD 2 ; bob
    %35  = GETFIELD %34, java/lang/Object.age
    %36  = CONCAT %33, %35
    %39  = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %39, java/io/PrintStream.println(%36)
    %40  = SCONST ""
    %43  = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %43, java/io/PrintStream.println(%40)
    %44  = LOAD 1 ; alice
    %45  = INVOKEVIRTUAL %44, java/lang/Object.Greet()
    %48  = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %48, java/io/PrintStream.println(%45)
    %49  = LOAD 2 ; bob
    %50  = INVOKEVIRTUAL %49, java/lang/Object.Greet()
    %53  = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %53, java/io/PrintStream.println(%50)
    %54  = SCONST ""
    %57  = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %57, java/io/PrintStream.println(%54)
    %58  = SCONST "Alice older than Bob: "
    %59  = LOAD 1 ; alice
    %60  = LOAD 2 ; bob
    %61  = INVOKEVIRTUAL %59, java/lang/Object.IsOlderThan(%60)
    %62  = CONCAT %58, %61
    %65  = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %65, java/io/PrintStream.println(%62)
    %66  = SCONST "Bob older than Alice: "
    %67  = LOAD 2 ; bob
    %68  = LOAD 1 ; alice
    %69  = INVOKEVIRTUAL %67, java/lang/Object.IsOlderThan(%68)
    %70  = CONCAT %66, %69
    %73  = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %73, java/io/PrintStream.println(%70)
    %74  = SCONST ""
    %77  = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %77, java/io/PrintStream.println(%74)
    %78  = SCONST "=== OOP Class Test Complete ==="
    %81  = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %81, java/io/PrintStream.println(%78)
            RETURN
end function

