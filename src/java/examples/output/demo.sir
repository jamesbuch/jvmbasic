; SIR Module: demo
; ============================================================

; Entry point
static function main(args: Array[elementType=Reference[name=java.lang.String]])
  ; locals: args@0, x@1, y@2, sum@3, diff@4, product@5, quotient@6, count@7
  entry:
            ; var x
    %0   = ICONST 10
            STORE 1, %0 ; x
            ; var y
    %1   = ICONST 25
            STORE 2, %1 ; y
            ; var sum
    %2   = LOAD 1 ; x
    %3   = LOAD 2 ; y
    %4   = IADD %2, %3
            STORE 3, %4 ; sum
            ; var diff
    %5   = LOAD 2 ; y
    %6   = LOAD 1 ; x
    %7   = ISUB %5, %6
            STORE 4, %7 ; diff
            ; var product
    %8   = LOAD 1 ; x
    %9   = LOAD 2 ; y
    %10  = IMUL %8, %9
            STORE 5, %10 ; product
            ; var quotient
    %11  = LOAD 2 ; y
    %12  = LOAD 1 ; x
    %13  = IDIV %11, %12
            STORE 6, %13 ; quotient
    %14  = SCONST "=== JVM BASIC 2.0 Demo ==="
    %17  = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %17, java/io/PrintStream.println(%14)
    %18  = SCONST "x = 10, y = 25"
    %21  = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %21, java/io/PrintStream.println(%18)
    %22  = SCONST "sum (x + y):"
    %25  = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %25, java/io/PrintStream.println(%22)
    %26  = LOAD 3 ; sum
    %29  = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %29, java/io/PrintStream.println(%26)
    %30  = SCONST "difference (y - x):"
    %33  = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %33, java/io/PrintStream.println(%30)
    %34  = LOAD 4 ; diff
    %37  = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %37, java/io/PrintStream.println(%34)
    %38  = SCONST "product (x * y):"
    %41  = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %41, java/io/PrintStream.println(%38)
    %42  = LOAD 5 ; product
    %45  = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %45, java/io/PrintStream.println(%42)
    %46  = SCONST "quotient (y / x):"
    %49  = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %49, java/io/PrintStream.println(%46)
    %50  = LOAD 6 ; quotient
    %53  = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %53, java/io/PrintStream.println(%50)
    %54  = SCONST ""
    %57  = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %57, java/io/PrintStream.println(%54)
    %58  = SCONST "=== Conditionals ==="
    %61  = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %61, java/io/PrintStream.println(%58)
    %62  = LOAD 3 ; sum
    %63  = ICONST 30
    %64  = ICMP_GT %62, %63
            IFFALSE %64, else_1
  then_0:
    %65  = SCONST "Sum is greater than 30"
    %68  = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %68, java/io/PrintStream.println(%65)
            GOTO endif_2
  else_1:
    %69  = SCONST "Sum is not greater than 30"
    %72  = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %72, java/io/PrintStream.println(%69)
            GOTO endif_2
  endif_2:
    %73  = SCONST ""
    %76  = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %76, java/io/PrintStream.println(%73)
    %77  = SCONST "=== While Loop (countdown from 5) ==="
    %80  = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %80, java/io/PrintStream.println(%77)
            ; var count
    %81  = ICONST 5
            STORE 7, %81 ; count
            GOTO while_cond_3
  while_cond_3:
    %82  = LOAD 7 ; count
    %83  = ICONST 0
    %84  = ICMP_GT %82, %83
            IFFALSE %84, while_end_5
  while_body_4:
    %85  = LOAD 7 ; count
    %88  = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %88, java/io/PrintStream.println(%85)
    %89  = LOAD 7 ; count
    %90  = ICONST 1
    %91  = ISUB %89, %90
            STORE 7, %91 ; count
            GOTO while_cond_3
  while_end_5:
    %92  = SCONST "Liftoff!"
    %95  = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %95, java/io/PrintStream.println(%92)
    %96  = SCONST ""
    %99  = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %99, java/io/PrintStream.println(%96)
    %100 = SCONST "=== Demo Complete ==="
    %103 = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %103, java/io/PrintStream.println(%100)
            RETURN
end function

