CompilationUnit(class_test)
  Classes:
    class Person extends java.lang.Object
  Statements:
    Console.WriteLine("=== OOP Class Test ===")
    Console.WriteLine("")
    var alice: Reference[name=Person] = new Reference[name=Person]("Alice", 30)
    var bob: Reference[name=Person] = new Reference[name=Person]("Bob", 25)
    Console.WriteLine(((("Alice: " CONCAT alice.name) CONCAT ", age ") CONCAT alice.age))
    Console.WriteLine(((("Bob: " CONCAT bob.name) CONCAT ", age ") CONCAT bob.age))
    Console.WriteLine("")
    Console.WriteLine(alice.Greet())
    Console.WriteLine(bob.Greet())
    Console.WriteLine("")
    Console.WriteLine(("Alice older than Bob: " CONCAT alice.IsOlderThan(bob)))
    Console.WriteLine(("Bob older than Alice: " CONCAT bob.IsOlderThan(alice)))
    Console.WriteLine("")
    Console.WriteLine("=== OOP Class Test Complete ===")
