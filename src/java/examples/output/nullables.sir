    %0   = LOAD 0 ; name
    %1   = NULL
    %2   = ICMP_EQ %0, %1
            IFFALSE %2, else_1
  then_0:
    %3   = SCONST "Hello, stranger!"
            RETURN %3
  else_1:
    %4   = SCONST "Hello, "
    %5   = LOAD 0 ; name
    %6   = TOSTRING %5
    %7   = CONCAT %4, %6
    %8   = SCONST "!"
    %9   = CONCAT %7, %8
            RETURN %9
  endif_2:
    %10  = NULL
            RETURN %10
end function

