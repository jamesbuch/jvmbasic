    %5   = ICONST 0
    %6   = ICMP_EQ %4, %5
            IFFALSE %6, else_4
  then_3:
    %7   = NULL
            RETURN %7
  else_4:
            GOTO endif_5
  endif_5:
    %8   = LOAD 0 ; a
    %9   = LOAD 1 ; b
    %10  = IDIV %8, %9
            RETURN %10
end function

