; SIR Module: string_plus_test
; ============================================================

; Entry point
static function main(args: Array[elementType=Reference[name=java.lang.String]])
  ; locals: args@0, s1@1, s2@2, result1@3, num@4, result2@5, result3@6, x@7, y@8, result4@9, result5a@10, result5b@11, flag@12, result6@13, pi@14, result7@15
  entry:
    %0   = SCONST "=== String + Operator Test ==="
    %3   = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %3, java/io/PrintStream.println(%0)
    %4   = SCONST ""
    %7   = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %7, java/io/PrintStream.println(%4)
            ; var s1
    %8   = SCONST "Hello"
            STORE 1, %8 ; s1
            ; var s2
    %9   = SCONST "World"
            STORE 2, %9 ; s2
            ; var result1
    %10  = LOAD 1 ; s1
    %11  = SCONST " "
    %12  = CONCAT %10, %11
    %13  = LOAD 2 ; s2
    %14  = CONCAT %12, %13
            STORE 3, %14 ; result1
    %15  = SCONST "Test 1 (String + String): "
    %16  = LOAD 3 ; result1
    %17  = CONCAT %15, %16
    %20  = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %20, java/io/PrintStream.println(%17)
            ; var num
    %21  = ICONST 42
            STORE 4, %21 ; num
            ; var result2
    %22  = SCONST "The answer is: "
    %23  = LOAD 4 ; num
    %24  = CONCAT %22, %23
            STORE 5, %24 ; result2
    %25  = SCONST "Test 2 (String + Integer): "
    %26  = LOAD 5 ; result2
    %27  = CONCAT %25, %26
    %30  = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %30, java/io/PrintStream.println(%27)
            ; var result3
    %31  = LOAD 4 ; num
    %32  = SCONST " is the answer"
    %33  = CONCAT %31, %32
            STORE 6, %33 ; result3
    %34  = SCONST "Test 3 (Integer + String): "
    %35  = LOAD 6 ; result3
    %36  = CONCAT %34, %35
    %39  = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %39, java/io/PrintStream.println(%36)
            ; var x
    %40  = ICONST 10
            STORE 7, %40 ; x
            ; var y
    %41  = ICONST 20
            STORE 8, %41 ; y
            ; var result4
    %42  = SCONST "Sum of "
    %43  = LOAD 7 ; x
    %44  = CONCAT %42, %43
    %45  = SCONST " and "
    %46  = CONCAT %44, %45
    %47  = LOAD 8 ; y
    %48  = CONCAT %46, %47
    %49  = SCONST " is "
    %50  = CONCAT %48, %49
    %51  = LOAD 7 ; x
    %52  = LOAD 8 ; y
    %53  = IADD %51, %52
    %54  = CONCAT %50, %53
            STORE 9, %54 ; result4
    %55  = SCONST "Test 4 (Multiple concat): "
    %56  = LOAD 9 ; result4
    %57  = CONCAT %55, %56
    %60  = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %60, java/io/PrintStream.println(%57)
            ; var result5a
    %61  = SCONST "Using + operator: "
    %62  = LOAD 7 ; x
    %63  = CONCAT %61, %62
            STORE 10, %63 ; result5a
            ; var result5b
    %64  = SCONST "Using & operator: "
    %65  = LOAD 7 ; x
    %66  = CONCAT %64, %65
            STORE 11, %66 ; result5b
    %67  = SCONST "Test 5a: "
    %68  = LOAD 10 ; result5a
    %69  = CONCAT %67, %68
    %72  = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %72, java/io/PrintStream.println(%69)
    %73  = SCONST "Test 5b: "
    %74  = LOAD 11 ; result5b
    %75  = CONCAT %73, %74
    %78  = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %78, java/io/PrintStream.println(%75)
            ; var flag
    %79  = ICONST 1
            STORE 12, %79 ; flag
            ; var result6
    %80  = SCONST "Flag is "
    %81  = LOAD 12 ; flag
    %82  = CONCAT %80, %81
            STORE 13, %82 ; result6
    %83  = SCONST "Test 6 (Boolean): "
    %84  = LOAD 13 ; result6
    %85  = CONCAT %83, %84
    %88  = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %88, java/io/PrintStream.println(%85)
            ; var pi
    %89  = FCONST 3.14f
            STORE 14, %89 ; pi
            ; var result7
    %90  = SCONST "Pi is approximately "
    %91  = LOAD 14 ; pi
    %92  = CONCAT %90, %91
            STORE 15, %92 ; result7
    %93  = SCONST "Test 7 (Float): "
    %94  = LOAD 15 ; result7
    %95  = CONCAT %93, %94
    %98  = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %98, java/io/PrintStream.println(%95)
    %99  = SCONST ""
    %102 = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %102, java/io/PrintStream.println(%99)
    %103 = SCONST "=== All String + Tests Passed ==="
    %106 = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %106, java/io/PrintStream.println(%103)
            RETURN
end function

