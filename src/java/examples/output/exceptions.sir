; SIR Module: exceptions
; ============================================================

static function testException(which: Primitive[kind=INT]) -> Reference[name=java.lang.String]
  ; locals: which@0
  entry:
            ; try
    %0   = LOAD 0 ; which
    %1   = ICONST 1
    %2   = ICMP_EQ %0, %1
            IFFALSE %2, else_1
  then_0:
    %3   = NEW IllegalArgumentException
    %4   = DUP %3
    %5   = SCONST "Invalid argument"
            INVOKESPECIAL %4, IllegalArgumentException.<init>(%5)
            THROW %3
  else_1:
    %6   = NEW RuntimeException
    %7   = DUP %6
    %8   = SCONST "Generic error"
            INVOKESPECIAL %7, RuntimeException.<init>(%8)
            THROW %6
  endif_2:
    %9   = SCONST "No exception"
            RETURN %9
end function

static function dangerousOperation() -> Primitive[kind=INT]
  entry:
    %0   = NEW RuntimeException
    %1   = DUP %0
    %2   = SCONST "Something went wrong"
            INVOKESPECIAL %1, RuntimeException.<init>(%2)
            THROW %0
end function

static function wrapper() -> Primitive[kind=INT]
  entry:
            ; try
    %0   = INVOKESTATIC exceptions.dangerousOperation()
            RETURN %0
end function

static function safeDivide(a: Primitive[kind=INT], b: Primitive[kind=INT]) -> Primitive[kind=INT]
  ; locals: a@0, b@1
  entry:
            ; try
    %0   = LOAD 0 ; a
    %1   = LOAD 1 ; b
    %2   = IDIV %0, %1
            RETURN %2
end function

; Entry point
static function main(args: Array[elementType=Reference[name=java.lang.String]])
  ; locals: args@0, result@2
  entry:
    %0   = SCONST "=== Basic Try/Catch ==="
    %3   = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %3, java/io/PrintStream.println(%0)
            ; try
            ; var result
    %4   = ICONST 10
    %5   = ICONST 0
    %6   = IDIV %4, %5
            STORE 1, %6 ; result
    %7   = SCONST "This should not print"
    %10  = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %10, java/io/PrintStream.println(%7)
    %11  = SCONST "Execution continues after catch"
    %14  = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %14, java/io/PrintStream.println(%11)
    %15  = SCONST ""
    %18  = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %18, java/io/PrintStream.println(%15)
    %19  = SCONST "=== Try/Catch/Finally ==="
    %22  = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %22, java/io/PrintStream.println(%19)
            ; try
    %23  = SCONST "In try block"
    %26  = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %26, java/io/PrintStream.println(%23)
    %27  = NEW Exception
    %28  = DUP %27
    %29  = SCONST "Test exception"
            INVOKESPECIAL %28, Exception.<init>(%29)
            THROW %27
    %30  = SCONST ""
    %33  = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %33, java/io/PrintStream.println(%30)
    %34  = SCONST "=== Finally Without Exception ==="
    %37  = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %37, java/io/PrintStream.println(%34)
            ; try
    %38  = SCONST "No exception thrown"
    %41  = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %41, java/io/PrintStream.println(%38)
    %42  = SCONST ""
    %45  = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %45, java/io/PrintStream.println(%42)
    %46  = SCONST "=== Multiple Catch Blocks ==="
    %49  = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %49, java/io/PrintStream.println(%46)
    %50  = ICONST 1
    %51  = INVOKESTATIC exceptions.testException(%50)
    %54  = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %54, java/io/PrintStream.println(%51)
    %55  = ICONST 2
    %56  = INVOKESTATIC exceptions.testException(%55)
    %59  = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %59, java/io/PrintStream.println(%56)
    %60  = ICONST 3
    %61  = INVOKESTATIC exceptions.testException(%60)
    %64  = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %64, java/io/PrintStream.println(%61)
    %65  = SCONST ""
    %68  = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %68, java/io/PrintStream.println(%65)
    %69  = SCONST "=== Rethrow ==="
    %72  = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %72, java/io/PrintStream.println(%69)
            ; try
            ; var result
    %73  = INVOKESTATIC exceptions.wrapper()
            STORE 2, %73 ; result
    %74  = SCONST ""
    %77  = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %77, java/io/PrintStream.println(%74)
    %78  = SCONST "=== Nested Try Blocks ==="
    %81  = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %81, java/io/PrintStream.println(%78)
            ; try
    %82  = SCONST "Outer try"
    %85  = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %85, java/io/PrintStream.println(%82)
            ; try
    %86  = SCONST "Inner try"
    %89  = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %89, java/io/PrintStream.println(%86)
    %90  = NEW Exception
    %91  = DUP %90
    %92  = SCONST "Inner exception"
            INVOKESPECIAL %91, Exception.<init>(%92)
            THROW %90
    %93  = SCONST ""
    %96  = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %96, java/io/PrintStream.println(%93)
    %97  = SCONST "=== Exception with Return ==="
    %100 = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %100, java/io/PrintStream.println(%97)
    %101 = SCONST "10 / 2 = "
    %102 = ICONST 10
    %103 = ICONST 2
    %104 = INVOKESTATIC exceptions.safeDivide(%102, %103)
    %105 = INVOKEVIRTUAL %104, java/lang/Object.ToString()
    %106 = CONCAT %101, %105
    %109 = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %109, java/io/PrintStream.println(%106)
    %110 = SCONST "10 / 0 = "
    %111 = ICONST 10
    %112 = ICONST 0
    %113 = INVOKESTATIC exceptions.safeDivide(%111, %112)
    %114 = INVOKEVIRTUAL %113, java/lang/Object.ToString()
    %115 = CONCAT %110, %114
    %118 = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %118, java/io/PrintStream.println(%115)
    %119 = SCONST ""
    %122 = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %122, java/io/PrintStream.println(%119)
    %123 = SCONST "All exception tests complete!"
    %126 = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %126, java/io/PrintStream.println(%123)
            RETURN
end function

