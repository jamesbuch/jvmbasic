; SIR Module: db_test
; ============================================================

; Entry point
static function main(args: Array[elementType=Reference[name=java.lang.String]])
  ; locals: args@0
  entry:
    %0   = SCONST "=== Database Namespace Test ==="
    %3   = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %3, java/io/PrintStream.println(%0)
    %4   = SCONST ""
    %7   = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %7, java/io/PrintStream.println(%4)
    %8   = SCONST "DB functions available:"
    %11  = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %11, java/io/PrintStream.println(%8)
    %12  = SCONST "- Db.Connect(url, user, password)"
    %15  = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %15, java/io/PrintStream.println(%12)
    %16  = SCONST "- Db.Close()"
    %19  = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %19, java/io/PrintStream.println(%16)
    %20  = SCONST "- Db.Query(sql)"
    %23  = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %23, java/io/PrintStream.println(%20)
    %24  = SCONST "- Db.Execute(sql)"
    %27  = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %27, java/io/PrintStream.println(%24)
    %28  = SCONST "- Db.Prepare(sql)"
    %31  = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %31, java/io/PrintStream.println(%28)
    %32  = SCONST "- Db.SetString/SetInt/SetDouble(index, value)"
    %35  = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %35, java/io/PrintStream.println(%32)
    %36  = SCONST "- Db.ExecuteQuery()/ExecuteUpdate()"
    %39  = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %39, java/io/PrintStream.println(%36)
    %40  = SCONST "- Db.Next()"
    %43  = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %43, java/io/PrintStream.println(%40)
    %44  = SCONST "- Db.GetString/GetInt/GetDouble(column)"
    %47  = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %47, java/io/PrintStream.println(%44)
    %48  = SCONST "- Db.BeginTransaction/Commit/Rollback()"
    %51  = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %51, java/io/PrintStream.println(%48)
    %52  = SCONST ""
    %55  = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %55, java/io/PrintStream.println(%52)
    %56  = SCONST "=== Database Test Complete ==="
    %59  = GETSTATIC java/lang/System.out
            INVOKEVIRTUAL %59, java/io/PrintStream.println(%56)
            RETURN
end function

