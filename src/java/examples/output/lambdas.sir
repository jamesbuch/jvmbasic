static function applyToRange(start: Primitive[kind=INT], finish: Primitive[kind=INT], fn: Function[paramTypes=[Primitive[kind=INT]], returnType=Primitive[kind=INT]]) -> Primitive[kind=INT]
  ; locals: start@0, finish@1, fn@2, total@3, i@4
  entry:
            ; var total
    %0   = ICONST 0
            STORE 3, %0 ; total
            ; for i
    %1   = LOAD 0 ; start
            STORE 4, %1 ; i
            GOTO for_cond_0
  for_cond_0:
    %2   = LOAD 4 ; i
    %3   = LOAD 1 ; finish
    %4   = ICMP_LE %2, %3
            IFFALSE %4, for_end_3
  for_body_1:
    %5   = LOAD 4 ; i
    %6   = INVOKESTATIC lambdas.fn(%5)
            STORE 3, %6 ; total
            GOTO for_step_2
  for_step_2:
    %7   = LOAD 4 ; i
    %8   = ICONST 1
    %9   = IADD %7, %8
            STORE 4, %9 ; i
            GOTO for_cond_0
  for_end_3:
    %10  = LOAD 3 ; total
            RETURN %10
end function

static function transform(arr: Array[elementType=Primitive[kind=INT]], length: Primitive[kind=INT], fn: Function[paramTypes=[Primitive[kind=INT]], returnType=Primitive[kind=INT]]) -> Array[elementType=Primitive[kind=INT]]
  ; locals: arr@0, length@1, fn@2, result@3, i@4
  entry:
            ; var result
    %0   = LOAD 1 ; length
    %1   = NEWARRAY Primitive[kind=INT], %0
            STORE 3, %1 ; result
            ; for i
    %2   = ICONST 0
            STORE 4, %2 ; i
            GOTO for_cond_0
  for_cond_0:
    %3   = LOAD 4 ; i
    %4   = LOAD 1 ; length
    %5   = ICONST 1
    %6   = ISUB %4, %5
    %7   = ICMP_LE %3, %6
            IFFALSE %7, for_end_3
  for_body_1:
    %8   = LOAD 0 ; arr
    %9   = LOAD 4 ; i
    %10  = ARRAYLOAD %8, %9
    %11  = INVOKESTATIC lambdas.fn(%10)
            GOTO for_step_2
  for_step_2:
    %12  = LOAD 4 ; i
    %13  = ICONST 1
    %14  = IADD %12, %13
            STORE 4, %14 ; i
            GOTO for_cond_0
  for_end_3:
    %15  = LOAD 3 ; result
            RETURN %15
end function

static function countMatching(arr: Array[elementType=Primitive[kind=INT]], length: Primitive[kind=INT], predicate: Function[paramTypes=[Primitive[kind=INT]], returnType=Primitive[kind=BOOLEAN]]) -> Primitive[kind=INT]
  ; locals: arr@0, length@1, predicate@2, count@3, i@4
  entry:
            ; var count
    %0   = ICONST 0
            STORE 3, %0 ; count
            ; for i
    %1   = ICONST 0
            STORE 4, %1 ; i
            GOTO for_cond_0
  for_cond_0:
    %2   = LOAD 4 ; i
    %3   = LOAD 1 ; length
    %4   = ICONST 1
    %5   = ISUB %3, %4
    %6   = ICMP_LE %2, %5
            IFFALSE %6, for_end_3
  for_body_1:
    %7   = LOAD 0 ; arr
    %8   = LOAD 4 ; i
    %9   = ARRAYLOAD %7, %8
    %10  = INVOKESTATIC lambdas.predicate(%9)
            IFFALSE %10, else_5
  then_4:
    %11  = ICONST 1
            STORE 3, %11 ; count
            GOTO endif_6
  else_5:
            GOTO endif_6
  endif_6:
            GOTO for_step_2
  for_step_2:
    %12  = LOAD 4 ; i
    %13  = ICONST 1
    %14  = IADD %12, %13
            STORE 4, %14 ; i
            GOTO for_cond_0
  for_end_3:
    %15  = LOAD 3 ; count
            RETURN %15
end function

static function multiplier(factor: Primitive[kind=INT]) -> Function[paramTypes=[Primitive[kind=INT]], returnType=Primitive[kind=INT]]
  ; locals: factor@0
  entry:
    %0   = NULL
            RETURN %0
end function

static function reduce(arr: Array[elementType=Primitive[kind=INT]], length: Primitive[kind=INT], initial: Primitive[kind=INT], fn: Function[paramTypes=[Primitive[kind=INT], Primitive[kind=INT]], returnType=Primitive[kind=INT]]) -> Primitive[kind=INT]
  ; locals: arr@0, length@1, initial@2, fn@3, acc@4, i@5
  entry:
            ; var acc
    %0   = LOAD 2 ; initial
            STORE 4, %0 ; acc
            ; for i
    %1   = ICONST 0
            STORE 5, %1 ; i
            GOTO for_cond_0
  for_cond_0:
    %2   = LOAD 5 ; i
    %3   = LOAD 1 ; length
    %4   = ICONST 1
    %5   = ISUB %3, %4
    %6   = ICMP_LE %2, %5
            IFFALSE %6, for_end_3
  for_body_1:
    %7   = LOAD 4 ; acc
    %8   = LOAD 0 ; arr
    %9   = LOAD 5 ; i
    %10  = ARRAYLOAD %8, %9
    %11  = INVOKESTATIC lambdas.fn(%7, %10)
            STORE 4, %11 ; acc
            GOTO for_step_2
  for_step_2:
    %12  = LOAD 5 ; i
    %13  = ICONST 1
    %14  = IADD %12, %13
            STORE 5, %14 ; i
            GOTO for_cond_0
  for_end_3:
    %15  = LOAD 4 ; acc
            RETURN %15
end function

