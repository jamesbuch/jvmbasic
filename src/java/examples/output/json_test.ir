CompilationUnit(json_test)
  Statements:
    Console.WriteLine("=== JSON Namespace Test ===")
    Console.WriteLine("")
    var json: Reference[name=java.lang.String] = Json.Create()
    Console.WriteLine(("Empty JSON: " CONCAT json))
    json = Json.Set(json, "name", "Alice")
    json = Json.Set(json, "age", "30")
    json = Json.SetBool(json, "active", true)
    Console.WriteLine(("After setting values: " CONCAT json))
    var name: Reference[name=java.lang.String] = Json.Get(json, "name")
    var age: Primitive[kind=INT] = Json.GetInt(json, "age")
    var active: Primitive[kind=BOOLEAN] = Json.GetBool(json, "active")
    Console.WriteLine(("Name: " CONCAT name))
    Console.WriteLine(("Age: " CONCAT age))
    Console.WriteLine(("Active: " CONCAT active))
    Console.WriteLine(("Has 'name': " CONCAT Json.Has(json, "name")))
    Console.WriteLine(("Has 'email': " CONCAT Json.Has(json, "email")))
    Console.WriteLine(("Is valid JSON: " CONCAT Json.IsValid(json)))
    Console.WriteLine(("Is object: " CONCAT Json.IsObject(json)))
    var person: Reference[name=java.lang.String] = Json.FromPairs("firstName", "Bob", "lastName", "Smith", "score", "95")
    Console.WriteLine(("Person from pairs: " CONCAT person))
    var arr: Reference[name=java.lang.String] = Json.CreateArray()
    arr = Json.Push(arr, "apple")
    arr = Json.Push(arr, "banana")
    arr = Json.Push(arr, "cherry")
    Console.WriteLine(("Fruits array: " CONCAT arr))
    Console.WriteLine(("Is array: " CONCAT Json.IsArray(arr)))
    Console.WriteLine(("Array length: " CONCAT Json.Length(arr)))
    Console.WriteLine(("Element 1: " CONCAT Json.Get(arr, "1")))
    Console.WriteLine("")
    Console.WriteLine("Pretty printed:")
    Console.WriteLine(Json.Pretty(json))
    var nested: Reference[name=java.lang.String] = Json.Create()
    nested = Json.SetJson(nested, "user", person)
    nested = Json.SetJson(nested, "fruits", arr)
    Console.WriteLine("")
    Console.WriteLine("Nested JSON:")
    Console.WriteLine(Json.Pretty(nested))
    Console.WriteLine("")
    Console.WriteLine(("Keys count: " CONCAT Json.Length(json)))
    Console.WriteLine("")
    Console.WriteLine("=== JSON Test Complete ===")
