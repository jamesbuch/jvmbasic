// expressions.jvmb - Test all expression types and operators

// ============================================================================
// Arithmetic Operators
// ============================================================================

var a as Integer = 10
var b as Integer = 3

Console.WriteLine($"Arithmetic operators (a={a}, b={b}):")
Console.WriteLine($"  a + b = {a + b}")
Console.WriteLine($"  a - b = {a - b}")
Console.WriteLine($"  a * b = {a * b}")
Console.WriteLine($"  a / b = {a / b}")
Console.WriteLine($"  a \\ b = {a \ b}")  // Integer division
Console.WriteLine($"  a mod b = {a mod b}")
Console.WriteLine($"  a ^ 2 = {a ^ 2}")   // Power

// Floating point
var x as Double = 10.5
var y as Double = 3.2
Console.WriteLine($"Floating point (x={x}, y={y}):")
Console.WriteLine($"  x / y = {x / y}")

// ============================================================================
// Comparison Operators
// ============================================================================

Console.WriteLine("Comparison operators:")
Console.WriteLine($"  10 = 10: {10 = 10}")
Console.WriteLine($"  10 <> 5: {10 <> 5}")
Console.WriteLine($"  10 < 20: {10 < 20}")
Console.WriteLine($"  10 > 5: {10 > 5}")
Console.WriteLine($"  10 <= 10: {10 <= 10}")
Console.WriteLine($"  10 >= 5: {10 >= 5}")

// ============================================================================
// Logical Operators
// ============================================================================

var t as Boolean = true
var f as Boolean = false

Console.WriteLine("Logical operators:")
Console.WriteLine($"  true and true: {t and t}")
Console.WriteLine($"  true and false: {t and f}")
Console.WriteLine($"  true or false: {t or f}")
Console.WriteLine($"  false or false: {f or f}")
Console.WriteLine($"  true xor true: {t xor t}")
Console.WriteLine($"  true xor false: {t xor f}")
Console.WriteLine($"  not true: {not t}")
Console.WriteLine($"  not false: {not f}")

// ============================================================================
// Bitwise Operators
// ============================================================================

var m as Integer = 0b1010  // 10
var n as Integer = 0b1100  // 12

Console.WriteLine("Bitwise operators (m=0b1010=10, n=0b1100=12):")
Console.WriteLine($"  m + n = {m + n}")    // AND = 0b1000 = 8
Console.WriteLine($"  m | n = {m | n}")    // OR = 0b1110 = 14
Console.WriteLine($"  m xor n = {m xor n}") // XOR = 0b0110 = 6
Console.WriteLine($"  ~m = {~m}")           // NOT
Console.WriteLine($"  m << 2 = {m << 2}")  // Shift left = 40
Console.WriteLine($"  n >> 1 = {n >> 1}")  // Shift right = 6

// ============================================================================
// String Operators
// ============================================================================

var firstName as String = "John"
var lastName as String = "Doe"

Console.WriteLine("String concatenation:")
Console.WriteLine($"  firstName + lastName = {firstName} {lastName}")

// ============================================================================
// Compound Assignment
// ============================================================================

var c as Integer = 10
Console.WriteLine("Compound assignment (starting c=10):")

c += 5
Console.WriteLine($"  c += 5: c = {c}")

c -= 3
Console.WriteLine($"  c -= 3: c = {c}")

c *= 2
Console.WriteLine($"  c *= 2: c = {c}")

c /= 4
Console.WriteLine($"  c /= 4: c = {c}")

// ============================================================================
// Unary Operators
// ============================================================================

var p as Integer = 5
var q as Integer = -5

Console.WriteLine("Unary operators:")
Console.WriteLine($"  +p = {+p}")
Console.WriteLine($"  -p = {-p}")
Console.WriteLine($"  -q = {-q}")

// ============================================================================
// Operator Precedence
// ============================================================================

Console.WriteLine("Operator precedence:")
Console.WriteLine($"  2 + 3 * 4 = {2 + 3 * 4}")      // 14
Console.WriteLine($"  (2 + 3) * 4 = {(2 + 3) * 4}")  // 20
Console.WriteLine($"  2 ^ 3 ^ 2 = {2 ^ 3 ^ 2}")      // Power is right-assoc
Console.WriteLine($"  10 - 5 - 2 = {10 - 5 - 2}")    // Left-assoc = 3

// ============================================================================
// Ternary Operator
// ============================================================================

var age as Integer = 21
var status as String = age >= 18 ? "Adult" : "Minor"
Console.WriteLine($"Ternary: age {age} is {status}")

age = 15
status = age >= 18 ? "Adult" : "Minor"
Console.WriteLine($"Ternary: age {age} is {status}")
