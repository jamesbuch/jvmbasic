' Regex namespace test

Console.WriteLine("Regex namespace test:")

' IsMatch - full string match
Console.WriteLine("IsMatch test:")
if Regex.IsMatch("hello123", "[a-z]+[0-9]+") then
    Console.WriteLine("Matched!")
else
    Console.WriteLine("No match")
end if

' Contains - pattern anywhere in string
Console.WriteLine("Contains test:")
if Regex.Contains("The quick brown fox", "quick") then
    Console.WriteLine("Found quick!")
else
    Console.WriteLine("Not found")
end if

' IsEmail validation
Console.WriteLine("Email validation:")
if Regex.IsEmail("test@example.com") then
    Console.WriteLine("Valid email")
else
    Console.WriteLine("Invalid email")
end if

if Regex.IsEmail("not-an-email") then
    Console.WriteLine("Valid email")
else
    Console.WriteLine("Invalid email")
end if

' ReplaceAll
Console.WriteLine("Replace test:")
var text as String = "foo bar foo baz"
Console.WriteLine(Regex.ReplaceAll(text, "foo", "replaced"))

' Find
Console.WriteLine("Find test:")
var input as String = "abc123def456"
Console.WriteLine(Regex.Find(input, "[0-9]+"))

' Count
Console.WriteLine("Count test:")
Console.WriteLine(Regex.Count(input, "[0-9]+"))

' IsDigitsOnly
Console.WriteLine("IsDigitsOnly test:")
if Regex.IsDigitsOnly("12345") then
    Console.WriteLine("Only digits")
else
    Console.WriteLine("Not only digits")
end if

Console.WriteLine("Regex test complete!")
