' password_generator.jvmb - Secure Password Generator
' Demonstrates: Crypto, Str namespaces

Console.WriteLine("=== Secure Password Generator ===")
Console.WriteLine("")

' Character pool
var charPool as String = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789!@#$%^&*"
var poolSize as Integer = Str.Length(charPool)

Console.WriteLine($"Character pool size: {poolSize}")
Console.WriteLine("")

' Generate passwords
Console.WriteLine("Generated Passwords:")
Console.WriteLine("--------------------")

' Generate inline (workaround for function return issue)
var p1 as String = ""
for i = 1 to 16
    p1 = p1 + Str.Substring(charPool, Crypto.RandomInt(0, poolSize - 1), 1)
next i
Console.WriteLine($"1. {p1}")

var p2 as String = ""
for j = 1 to 16
    p2 = p2 + Str.Substring(charPool, Crypto.RandomInt(0, poolSize - 1), 1)
next j
Console.WriteLine($"2. {p2}")

var p3 as String = ""
for k = 1 to 16
    p3 = p3 + Str.Substring(charPool, Crypto.RandomInt(0, poolSize - 1), 1)
next k
Console.WriteLine($"3. {p3}")

Console.WriteLine("")

' Random tokens
Console.WriteLine("Random Tokens:")
Console.WriteLine($"  UUID: {Crypto.Uuid()}")
Console.WriteLine($"  Hex (32): {Crypto.RandomBytes(16)}")
Console.WriteLine($"  Base64: {Crypto.RandomBase64(24)}")
Console.WriteLine("")

' Password hashing demo
Console.WriteLine("Password Hashing Demo:")
var samplePwd as String = "MySecurePass123!"
Console.WriteLine($"  Password: {samplePwd}")

var argonHash as String = Crypto.Argon2Hash(samplePwd)
Console.WriteLine($"  Argon2: {Str.Substring(argonHash, 0, 40)}...")

var bcryptHash as String = Crypto.BcryptHash(samplePwd)
Console.WriteLine($"  BCrypt: {bcryptHash}")

var isValid as Boolean = Crypto.Argon2Verify(samplePwd, argonHash)
Console.WriteLine($"  Verify: {isValid}")

Console.WriteLine("")
Console.WriteLine("=== Generator Complete ===")
