// imports.jvmb - Demonstrate built-in namespaces
//
// Note: Java imports are supported but object method calls have issues.
// This example shows how to use JVM BASIC's built-in namespaces instead
// which work correctly: Array, File, Date, Json, Str, Math, etc.

// ============================================================================
// Using ArrayList
// ============================================================================

Console.WriteLine("=== ArrayList ===")

// Use String[] instead of ArrayList to avoid method call issues
var items as String[] = new String[3]
items[0] = "First"
items[1] = "Second"
items[2] = "Third"

var listSize as Integer = Array.Length(items)
Console.WriteLine($"List size: {listSize}")
var hasSecond as Boolean = Array.Contains(items, "Second")
Console.WriteLine($"Contains 'Second': {hasSecond}")

// ============================================================================
// Using HashMap - Simplified
// ============================================================================

Console.WriteLine("")
Console.WriteLine("=== HashMap ===")

// HashMap method calls don't work properly yet (method chaining issue)
// Show that we can use JSON namespace for key-value data instead
var jsonData as String = "{\"name\":\"Alice\",\"age\":30,\"city\":\"New York\"}"
Console.WriteLine($"JSON data: {jsonData}")
var nameVal as String = Json.Get(jsonData, "name")
Console.WriteLine($"Name from JSON: {nameVal}")

// ============================================================================
// Using Date - via Date namespace
// ============================================================================

Console.WriteLine("")
Console.WriteLine("=== Date ===")

// Use our Date namespace instead of java.util.Date
var nowStr as String = Date.Now()
Console.WriteLine($"Current time: {nowStr}")
var timestamp as Long = Date.Timestamp()
Console.WriteLine($"Unix timestamp: {timestamp}")

// ============================================================================
// Using File - via File namespace
// ============================================================================

Console.WriteLine("")
Console.WriteLine("=== File ===")

// Use our File namespace instead of java.io.File
var filePath as String = "."
var exists as Boolean = File.Exists(filePath)
Console.WriteLine($"Path '{filePath}' exists: {exists}")

// ============================================================================
// Working Directory
// ============================================================================

Console.WriteLine("")
Console.WriteLine("=== Working Directory ===")

var tempPath as String = "/tmp"
var tempExists as Boolean = File.Exists(tempPath)
Console.WriteLine($"Temp directory exists: {tempExists}")

Console.WriteLine("")
Console.WriteLine("All import tests complete!")
