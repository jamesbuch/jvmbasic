' oop_abstract_shapes.jvmb - Abstract Classes Demo (Simplified)
' Demonstrates abstract classes with single-level inheritance

Console.WriteLine("=== Abstract Classes Demo ===")
Console.WriteLine("")

' Abstract base class
abstract class Shape
    public var name as String

    public sub New(shapeName as String)
        this.name = shapeName
    end sub

    public abstract function Area() as Double
end class

' Concrete class: Circle
class Circle extends Shape
    public var radius as Double

    public sub New(r as Double)
        super.New("Circle")
        this.radius = r
    end sub

    public override function Area() as Double
        return 3.14159 * this.radius * this.radius
    end function
end class

' Concrete class: Square
class Square extends Shape
    public var side as Double

    public sub New(s as Double)
        super.New("Square")
        this.side = s
    end sub

    public override function Area() as Double
        return this.side * this.side
    end function
end class

' Test
Console.WriteLine("Creating shapes...")

var circle as Circle = new Circle(5.0)
Console.WriteLine("Circle name: " + circle.name)
Console.WriteLine("Circle radius: " + circle.radius.ToString())
Console.WriteLine("Circle area: " + circle.Area().ToString())
Console.WriteLine("")

var square as Square = new Square(4.0)
Console.WriteLine("Square name: " + square.name)
Console.WriteLine("Square side: " + square.side.ToString())
Console.WriteLine("Square area: " + square.Area().ToString())
Console.WriteLine("")

Console.WriteLine("Demo complete!")
