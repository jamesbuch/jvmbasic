' task_app.jvmb - Task Management App with Alpine.js, HTMX, TailwindCSS
' =====================================================================
' A full-featured task management web application demonstrating:
' - Alpine.js for reactive UI
' - HTMX for AJAX without JavaScript
' - TailwindCSS for styling
' - JVM BASIC Jetty integration for the backend
'
' TO RUN:
' 1. Compile: java -jar build/libs/jvmbasic.jar examples/task_app.jvmb -o TaskApp
' 2. Run: java -cp '.:lib/*' TaskApp
' 3. Open: http://localhost:8080

' =====================================================================
' Data Storage
' =====================================================================
var tasks as String[] = new String[1000]
var taskCompleted as Boolean[] = new Boolean[1000]
var nextTaskId as Integer = 1

' =====================================================================
' HTML Templates
' =====================================================================

' Render the main page HTML
sub HandleMainPage()
    Response.SetContentType("text/html")
    Response.Write("<!DOCTYPE html>")
    Response.Write("<html lang=\"en\">")
    Response.Write("<head>")
    Response.Write("<meta charset=\"UTF-8\">")
    Response.Write("<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">")
    Response.Write("<title>JVM BASIC Task Manager</title>")
    ' TailwindCSS from CDN
    Response.Write("<script src=\"https://cdn.tailwindcss.com\"></script>")
    ' Alpine.js
    Response.Write("<script defer src=\"https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js\"></script>")
    ' HTMX
    Response.Write("<script src=\"https://unpkg.com/htmx.org@1.9.10\"></script>")
    Response.Write("<style>")
    Response.Write(".htmx-indicator { display: none; }")
    Response.Write(".htmx-request .htmx-indicator { display: inline; }")
    Response.Write(".htmx-request.htmx-indicator { display: inline; }")
    Response.Write("</style>")
    Response.Write("</head>")
    Response.Write("<body class=\"bg-gray-100 min-h-screen\">")

    ' Main container
    Response.Write("<div class=\"container mx-auto px-4 py-8 max-w-2xl\">")

    ' Header
    Response.Write("<div class=\"text-center mb-8\">")
    Response.Write("<h1 class=\"text-4xl font-bold text-gray-800 mb-2\">Task Manager</h1>")
    Response.Write("<p class=\"text-gray-600\">Built with JVM BASIC, Alpine.js, HTMX & TailwindCSS</p>")
    Response.Write("</div>")

    ' Add Task Form using HTMX
    Response.Write("<div class=\"bg-white rounded-lg shadow-md p-6 mb-6\">")
    Response.Write("<form hx-post=\"/api/tasks\" hx-target=\"#task-list\" hx-swap=\"innerHTML\" hx-on::after-request=\"this.reset()\" class=\"flex gap-4\">")
    Response.Write("<input type=\"text\" name=\"title\" placeholder=\"What needs to be done?\" ")
    Response.Write("class=\"flex-1 px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500\" required>")
    Response.Write("<button type=\"submit\" class=\"px-6 py-2 bg-blue-500 text-white rounded-lg hover:bg-blue-600 transition-colors\">")
    Response.Write("<span class=\"htmx-indicator\">Adding...</span>")
    Response.Write("<span class=\"htmx-indicator:hidden\">Add Task</span>")
    Response.Write("</button>")
    Response.Write("</form>")
    Response.Write("</div>")

    ' Filter buttons using Alpine.js
    Response.Write("<div x-data=\"{ filter: 'all' }\" class=\"mb-4\">")
    Response.Write("<div class=\"flex gap-2 justify-center mb-4\">")
    Response.Write("<button @click=\"filter = 'all'\" :class=\"filter === 'all' ? 'bg-blue-500 text-white' : 'bg-gray-200 text-gray-700'\" ")
    Response.Write("class=\"px-4 py-2 rounded-lg transition-colors\" hx-get=\"/api/tasks/html\" hx-target=\"#task-list\">All</button>")
    Response.Write("<button @click=\"filter = 'active'\" :class=\"filter === 'active' ? 'bg-blue-500 text-white' : 'bg-gray-200 text-gray-700'\" ")
    Response.Write("class=\"px-4 py-2 rounded-lg transition-colors\" hx-get=\"/api/tasks/html?filter=active\" hx-target=\"#task-list\">Active</button>")
    Response.Write("<button @click=\"filter = 'completed'\" :class=\"filter === 'completed' ? 'bg-blue-500 text-white' : 'bg-gray-200 text-gray-700'\" ")
    Response.Write("class=\"px-4 py-2 rounded-lg transition-colors\" hx-get=\"/api/tasks/html?filter=completed\" hx-target=\"#task-list\">Completed</button>")
    Response.Write("</div>")
    Response.Write("</div>")

    ' Task List Container
    Response.Write("<div id=\"task-list\" class=\"space-y-2\" hx-get=\"/api/tasks/html\" hx-trigger=\"load\">")
    Response.Write("<div class=\"text-center py-8 text-gray-500\">Loading tasks...</div>")
    Response.Write("</div>")

    ' Stats Footer
    Response.Write("<div hx-get=\"/api/stats\" hx-trigger=\"load, htmx:afterSettle from:body\" class=\"mt-6 text-center text-gray-600\" id=\"stats\">")
    Response.Write("</div>")

    ' Footer
    Response.Write("<div class=\"mt-8 text-center text-gray-500 text-sm\">")
    Response.Write("<p>Powered by JVM BASIC 2.0</p>")
    Response.Write("<p class=\"mt-1\">Using Jetty 11.0, Alpine.js 3.x, HTMX 1.9, TailwindCSS 3.x</p>")
    Response.Write("</div>")

    Response.Write("</div>")
    Response.Write("</body>")
    Response.Write("</html>")
end sub

' Render task list as HTML (for HTMX)
sub HandleTaskListHtml()
    Response.SetContentType("text/html")

    var filterParam as String = Request.GetParameter("filter")
    var count as Integer = 0

    for i = 1 to nextTaskId - 1
        if Str.Length(tasks[i]) > 0 then
            var showTask as Boolean = true
            if filterParam = "active" and taskCompleted[i] then
                showTask = false
            elseif filterParam = "completed" and not taskCompleted[i] then
                showTask = false
            end if

            if showTask then
                count = count + 1
                RenderTaskItem(i)
            end if
        end if
    next i

    if count = 0 then
        Response.Write("<div class=\"text-center py-8 text-gray-500\">")
        if filterParam = "active" then
            Response.Write("No active tasks. Time to relax!")
        elseif filterParam = "completed" then
            Response.Write("No completed tasks yet.")
        else
            Response.Write("No tasks yet. Add one above!")
        end if
        Response.Write("</div>")
    end if
end sub

' Render a single task item
sub RenderTaskItem(taskId as Integer)
    var title as String = tasks[taskId]
    var completed as Boolean = taskCompleted[taskId]

    Response.Write("<div class=\"bg-white rounded-lg shadow p-4 flex items-center gap-4 group\" id=\"task-" + taskId + "\">")

    ' Checkbox
    if completed then
        Response.Write("<button hx-post=\"/api/tasks/" + taskId + "/toggle\" hx-target=\"#task-list\" hx-swap=\"innerHTML\" ")
        Response.Write("hx-vals='{\"filter\": \"" + Request.GetParameter("filter") + "\"}' ")
        Response.Write("class=\"w-6 h-6 rounded-full border-2 border-green-500 bg-green-500 flex items-center justify-center\">")
        Response.Write("<svg class=\"w-4 h-4 text-white\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">")
        Response.Write("<path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M5 13l4 4L19 7\"></path>")
        Response.Write("</svg>")
    else
        Response.Write("<button hx-post=\"/api/tasks/" + taskId + "/toggle\" hx-target=\"#task-list\" hx-swap=\"innerHTML\" ")
        Response.Write("hx-vals='{\"filter\": \"" + Request.GetParameter("filter") + "\"}' ")
        Response.Write("class=\"w-6 h-6 rounded-full border-2 border-gray-300 hover:border-blue-500 transition-colors\">")
    end if
    Response.Write("</button>")

    ' Task title
    if completed then
        Response.Write("<span class=\"flex-1 text-gray-500 line-through\">" + title + "</span>")
    else
        Response.Write("<span class=\"flex-1 text-gray-800\">" + title + "</span>")
    end if

    ' Delete button
    Response.Write("<button hx-delete=\"/api/tasks/" + taskId + "\" hx-target=\"#task-list\" hx-swap=\"innerHTML\" ")
    Response.Write("hx-confirm=\"Are you sure you want to delete this task?\" ")
    Response.Write("class=\"opacity-0 group-hover:opacity-100 text-red-500 hover:text-red-700 transition-opacity\">")
    Response.Write("<svg class=\"w-5 h-5\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">")
    Response.Write("<path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16\"></path>")
    Response.Write("</svg>")
    Response.Write("</button>")

    Response.Write("</div>")
end sub

' =====================================================================
' API Endpoints
' =====================================================================

' POST /api/tasks - Create new task
sub HandleCreateTask()
    var body as String = Request.GetBody()
    var title as String = ""

    ' Extract title from form data (title=value) or JSON
    if Str.IndexOf(body, "title=") >= 0 then
        ' Form data
        title = Str.Substring(body, 6, Str.Length(body) - 6)
        ' URL decode (simple: replace + with space)
        title = Str.Replace(title, "+", " ")
        title = Str.Replace(title, "%20", " ")
    elseif Str.IndexOf(body, "\"title\"") >= 0 then
        ' JSON - extract title value
        var titleStart as Integer = Str.IndexOf(body, "\"title\"")
        var colonPos as Integer = Str.IndexOf(Str.Substring(body, titleStart, Str.Length(body) - titleStart), ":")
        if colonPos >= 0 then
            var afterColon as String = Str.Substring(body, titleStart + colonPos + 1, Str.Length(body) - titleStart - colonPos - 1)
            var quoteStart as Integer = Str.IndexOf(afterColon, "\"")
            if quoteStart >= 0 then
                var rest as String = Str.Substring(afterColon, quoteStart + 1, Str.Length(afterColon) - quoteStart - 1)
                var quoteEnd as Integer = Str.IndexOf(rest, "\"")
                if quoteEnd >= 0 then
                    title = Str.Substring(rest, 0, quoteEnd)
                end if
            end if
        end if
    end if

    if Str.Length(title) > 0 then
        var taskId as Integer = nextTaskId
        nextTaskId = nextTaskId + 1
        tasks[taskId] = title
        taskCompleted[taskId] = false
        Console.WriteLine("Created task " + taskId + ": " + title)
    end if

    ' Return updated task list
    HandleTaskListHtml()
end sub

' POST /api/tasks/{id}/toggle - Toggle task completion
sub HandleToggleTask()
    var idStr as String = Request.GetPathParam("id")
    var taskId as Integer = ParseInt(idStr)

    if taskId >= 1 and taskId < nextTaskId and Str.Length(tasks[taskId]) > 0 then
        taskCompleted[taskId] = not taskCompleted[taskId]
        Console.WriteLine("Toggled task " + taskId + " to " + taskCompleted[taskId])
    end if

    ' Return updated task list
    HandleTaskListHtml()
end sub

' DELETE /api/tasks/{id} - Delete task
sub HandleDeleteTask()
    var idStr as String = Request.GetPathParam("id")
    var taskId as Integer = ParseInt(idStr)

    if taskId >= 1 and taskId < nextTaskId then
        Console.WriteLine("Deleted task " + taskId + ": " + tasks[taskId])
        tasks[taskId] = ""
        taskCompleted[taskId] = false
    end if

    ' Return updated task list
    HandleTaskListHtml()
end sub

' GET /api/stats - Get task statistics
sub HandleStats()
    Response.SetContentType("text/html")

    var total as Integer = 0
    var completed as Integer = 0
    var active as Integer = 0

    for i = 1 to nextTaskId - 1
        if Str.Length(tasks[i]) > 0 then
            total = total + 1
            if taskCompleted[i] then
                completed = completed + 1
            else
                active = active + 1
            end if
        end if
    next i

    Response.Write("<span class=\"inline-flex gap-4\">")
    Response.Write("<span>" + total + " total</span>")
    Response.Write("<span class=\"text-blue-600\">" + active + " active</span>")
    Response.Write("<span class=\"text-green-600\">" + completed + " completed</span>")
    Response.Write("</span>")
end sub

' GET /api/tasks - JSON API for tasks
sub HandleTasksJson()
    Response.SetContentType("application/json")

    var result as String = "["
    var first as Boolean = true

    for i = 1 to nextTaskId - 1
        if Str.Length(tasks[i]) > 0 then
            if not first then
                result = result + ","
            end if
            result = result + "{\"id\":" + i + ",\"title\":\"" + tasks[i] + "\",\"completed\":" + taskCompleted[i] + "}"
            first = false
        end if
    next i

    result = result + "]"
    Response.Write(result)
end sub

' =====================================================================
' Helper Functions
' =====================================================================

function ParseInt(s as String) as Integer
    var result as Integer = 0
    for i = 0 to Str.Length(s) - 1
        var c as String = Str.Substring(s, i, 1)
        if c >= "0" and c <= "9" then
            result = result * 10 + (Str.CharAt(c, 0) - 48)
        end if
    next i
    return result
end function

' =====================================================================
' Main Program
' =====================================================================

Console.WriteLine("==============================================")
Console.WriteLine("   JVM BASIC Task Manager")
Console.WriteLine("   Alpine.js + HTMX + TailwindCSS")
Console.WriteLine("==============================================")
Console.WriteLine("")

' Create and configure server
var server as Integer = WebServer.Create(8080)

' Register routes
var r1 as Integer = WebServer.AddRoute(server, "GET", "/", "TaskApp", "HandleMainPage")
var r2 as Integer = WebServer.AddRoute(server, "GET", "/api/tasks/html", "TaskApp", "HandleTaskListHtml")
var r3 as Integer = WebServer.AddRoute(server, "POST", "/api/tasks", "TaskApp", "HandleCreateTask")
var r4 as Integer = WebServer.AddRoute(server, "POST", "/api/tasks/{id}/toggle", "TaskApp", "HandleToggleTask")
var r5 as Integer = WebServer.AddRoute(server, "DELETE", "/api/tasks/{id}", "TaskApp", "HandleDeleteTask")
var r6 as Integer = WebServer.AddRoute(server, "GET", "/api/stats", "TaskApp", "HandleStats")
var r7 as Integer = WebServer.AddRoute(server, "GET", "/api/tasks", "TaskApp", "HandleTasksJson")

Console.WriteLine("Routes registered:")
Console.WriteLine("  GET  /               - Main page")
Console.WriteLine("  GET  /api/tasks      - JSON task list")
Console.WriteLine("  GET  /api/tasks/html - HTML task list (HTMX)")
Console.WriteLine("  POST /api/tasks      - Create task")
Console.WriteLine("  POST /api/tasks/{id}/toggle - Toggle task")
Console.WriteLine("  DELETE /api/tasks/{id} - Delete task")
Console.WriteLine("  GET  /api/stats      - Task statistics")
Console.WriteLine("")

' Add some sample tasks
tasks[1] = "Learn JVM BASIC 2.0"
taskCompleted[1] = true
tasks[2] = "Build a web app with Alpine.js"
taskCompleted[2] = false
tasks[3] = "Explore HTMX features"
taskCompleted[3] = false
tasks[4] = "Style with TailwindCSS"
taskCompleted[4] = false
nextTaskId = 5

Console.WriteLine("Sample tasks added")
Console.WriteLine("")

' Start server
var started as Integer = WebServer.Start(server)
Console.WriteLine("Server running on http://localhost:8080")
Console.WriteLine("Press Ctrl+C to stop")
Console.WriteLine("")

WebServer.Join(server)
