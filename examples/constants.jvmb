// constants.jvmb - Test global variables used as constants

// ============================================================================
// Global Variables (used as constants)
// ============================================================================

var PI as Double = 3.14159265358979
var E as Double = 2.71828182845904
var GOLDEN_RATIO as Double = 1.61803398874989
var MAX_SIZE as Integer = 100
var APP_NAME as String = "JVM BASIC 2.0"
var DEBUG as Boolean = true

// Physics globals
var SPEED_OF_LIGHT as Long = 299792458L   // m/s
var GRAVITY as Double = 9.80665           // m/s^2

// Option values for switch
var OPTION_A as Integer = 1
var OPTION_B as Integer = 2
var OPTION_C as Integer = 3

// String globals
var GREETING as String = "Welcome to "
var FAREWELL as String = "Goodbye from "

// ============================================================================
// Using Globals
// ============================================================================

Console.WriteLine("=== Global Constants ===")
Console.WriteLine("PI = " + PI.ToString())
Console.WriteLine("E = " + E.ToString())
Console.WriteLine("Golden Ratio = " + GOLDEN_RATIO.ToString())
Console.WriteLine("Max Size = " + MAX_SIZE.ToString())
Console.WriteLine("App Name = " + APP_NAME)
Console.WriteLine("Debug = " + DEBUG.ToString())

// ============================================================================
// Globals in Calculations
// ============================================================================

Console.WriteLine("")
Console.WriteLine("=== Using Globals in Calculations ===")

var radius as Double = 5.0
var circumference as Double = 2 * PI * radius
var area as Double = PI * radius * radius

Console.WriteLine("Circle with radius " + radius.ToString() + ":")
Console.WriteLine("  Circumference = " + circumference.ToString())
Console.WriteLine("  Area = " + area.ToString())

// ============================================================================
// Physics Globals
// ============================================================================

Console.WriteLine("")
Console.WriteLine("=== Physics Constants ===")

Console.WriteLine("Speed of Light: " + SPEED_OF_LIGHT.ToString() + " m/s")
Console.WriteLine("Gravity: " + GRAVITY.ToString() + " m/s^2")

var mass as Double = 10.0
var weight as Double = mass * GRAVITY
Console.WriteLine("Weight of " + mass.ToString() + " kg: " + weight.ToString() + " N")

// ============================================================================
// Globals in Select Case
// ============================================================================

Console.WriteLine("")
Console.WriteLine("=== Constants in Switch ===")

var selection as Integer = 2

select case selection
case OPTION_A
    Console.WriteLine("Selected Option A")
case OPTION_B
    Console.WriteLine("Selected Option B")
case OPTION_C
    Console.WriteLine("Selected Option C")
case else
    Console.WriteLine("Unknown option")
end select

// ============================================================================
// String Globals
// ============================================================================

Console.WriteLine("")
Console.WriteLine("=== String Constants ===")

Console.WriteLine(GREETING + APP_NAME)
Console.WriteLine(FAREWELL + APP_NAME)

// ============================================================================
// Conditional Pattern
// ============================================================================

Console.WriteLine("")
Console.WriteLine("=== Debug Mode ===")

if DEBUG then
    Console.WriteLine("[DEBUG] Debugging is enabled")
    Console.WriteLine("[DEBUG] Max size configured: " + MAX_SIZE.ToString())
end if

Console.WriteLine("")
Console.WriteLine("All constant tests complete!")
