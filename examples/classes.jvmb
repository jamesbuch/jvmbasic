// classes.jvmb - Test classes, inheritance, interfaces, and OOP features

// ============================================================================
// Simple Class
// ============================================================================

public class Point
    private var x as Integer
    private var y as Integer

    // Constructor - use this.x to disambiguate from parameter x
    public sub new(x as Integer, y as Integer)
        this.x = x
        this.y = y
    end sub

    // Getters
    public function getX() as Integer
        return x
    end function

    public function getY() as Integer
        return y
    end function

    // Method
    public function distanceFromOrigin() as Double
        return Math.Sqrt(x * x + y * y)
    end function

    public function toString() as String
        return $"({x}, {y})"
    end function
end class

// ============================================================================
// Class with Properties
// ============================================================================

public class Person
    private var name as String
    private var age as Integer

    public sub new(name as String, age as Integer)
        this.name = name
        this.age = age
    end sub

    public property Name as String
        get
            return name
        end get
        set(value as String)
            name = value
        end set
    end property

    public property Age as Integer
        get
            return age
        end get
        set(value as Integer)
            if value >= 0 then
                age = value
            end if
        end set
    end property

    public function greet() as String
        return $"Hi, I'm {name} and I'm {age} years old"
    end function
end class

// ============================================================================
// Inheritance
// ============================================================================

public class Employee extends Person
    private var title as String
    private var salary as Double

    public sub new(name as String, age as Integer, title as String, salary as Double)
        Super.new(name, age)
        this.title = title
        this.salary = salary
    end sub

    public property Title as String
        get
            return title
        end get
        set(value as String)
            title = value
        end set
    end property

    public override function greet() as String
        return $"{Super.greet()}. I work as a {title}"
    end function

    public function getAnnualSalary() as Double
        return salary * 12
    end function
end class

// ============================================================================
// Interface
// ============================================================================

public interface IShape
    function area() as Double
    function perimeter() as Double
end interface

// ============================================================================
// Class implementing interface
// ============================================================================

public class Rectangle implements IShape
    private var width as Double
    private var height as Double

    public sub new(width as Double, height as Double)
        this.width = width
        this.height = height
    end sub

    public function area() as Double
        return width * height
    end function

    public function perimeter() as Double
        return 2 * (width + height)
    end function

    public function toString() as String
        return $"Rectangle({width} x {height})"
    end function
end class

public class Circle implements IShape
    private var radius as Double

    public sub new(radius as Double)
        this.radius = radius
    end sub

    public function area() as Double
        return 3.14159 * radius * radius
    end function

    public function perimeter() as Double
        return 2 * 3.14159 * radius
    end function

    public function toString() as String
        return $"Circle(r={radius})"
    end function
end class

// ============================================================================
// Abstract Class
// ============================================================================

public abstract class Animal
    protected var name as String

    public sub new(name as String)
        this.name = name
    end sub

    public function getName() as String
        return name
    end function

    // Abstract method - must be overridden
    public function speak() as String
        return ""
    end function
end class

public class Dog extends Animal
    public sub new(name as String)
        Super.new(name)
    end sub

    public override function speak() as String
        return $"{name} says: Woof!"
    end function
end class

public class Cat extends Animal
    public sub new(name as String)
        Super.new(name)
    end sub

    public override function speak() as String
        return $"{name} says: Meow!"
    end function
end class

// ============================================================================
// Static/Shared members
// ============================================================================

public class Counter
    shared var count as Integer = 0

    public sub new()
        count += 1
    end sub

    shared function getCount() as Integer
        return count
    end function
end class

// ============================================================================
// Main Program - Test all classes
// ============================================================================

// Test Point
var p as Point = new Point(3, 4)
Console.WriteLine($"Point: {p.toString()}")
Console.WriteLine($"Distance from origin: {p.distanceFromOrigin()}")

// Test Person
var person as Person = new Person("Alice", 30)
Console.WriteLine(person.greet())
person.Name = "Bob"
person.Age = 25
Console.WriteLine(person.greet())

// Test Employee (inheritance)
var emp as Employee = new Employee("Charlie", 35, "Developer", 5000.0)
Console.WriteLine(emp.greet())
Console.WriteLine($"Annual salary: {emp.getAnnualSalary()}")

// Test interface with different shapes
var rect as Rectangle = new Rectangle(10.0, 5.0)
var circle as Circle = new Circle(7.0)

Console.WriteLine($"{rect.toString()} - Area: {rect.area()}, Perimeter: {rect.perimeter()}")
Console.WriteLine($"{circle.toString()} - Area: {circle.area()}, Perimeter: {circle.perimeter()}")

// Test abstract class and polymorphism
var dog as Dog = new Dog("Buddy")
var cat as Cat = new Cat("Whiskers")
Console.WriteLine(dog.speak())
Console.WriteLine(cat.speak())

// Test static members
var c1 as Counter = new Counter()
var c2 as Counter = new Counter()
var c3 as Counter = new Counter()
Console.WriteLine($"Counter instances created: {Counter.getCount()}")
