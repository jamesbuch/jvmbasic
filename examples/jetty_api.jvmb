' jetty_api.jvmb - REST API Example with Jetty
' =====================================================================
' Demonstrates a simple REST API with JSON responses.
'
' TO RUN:
' 1. Compile: java -jar build/libs/jvmbasic.jar examples/jetty_api.jvmb -o ApiServer
' 2. Run: java -cp '.:lib/*' ApiServer
' 3. Test endpoints with curl:
'    curl http://localhost:8080/api/tasks
'    curl -X POST http://localhost:8080/api/tasks -d '{"title":"New Task"}'
'    curl http://localhost:8080/api/tasks/1

' Simple in-memory task storage (array of JSON strings)
var tasks as String[] = new String[100]
var nextTaskId as Integer = 1

' GET /api/tasks - List all tasks
sub HandleListTasks()
    Response.SetContentType("application/json")

    var result as String = "["
    var first as Boolean = true

    for i = 0 to nextTaskId - 1
        if Str.Length(tasks[i]) > 0 then
            if not first then
                result = result + ","
            end if
            result = result + tasks[i]
            first = false
        end if
    next i

    result = result + "]"
    Response.Write(result)
end sub

' GET /api/tasks/{id} - Get single task
sub HandleGetTask()
    var idStr as String = Request.GetPathParam("id")
    var id as Integer = 0

    ' Simple string to int conversion
    for i = 0 to Str.Length(idStr) - 1
        var c as String = Str.Substring(idStr, i, 1)
        if c >= "0" and c <= "9" then
            id = id * 10 + (Str.CharAt(c, 0) - 48)
        end if
    next i

    Response.SetContentType("application/json")

    if id < 1 or id >= nextTaskId or Str.Length(tasks[id]) = 0 then
        Response.SetStatus(404)
        Response.Write("{\"error\": \"Task not found\"}")
    else
        Response.Write(tasks[id])
    end if
end sub

' POST /api/tasks - Create task
sub HandleCreateTask()
    var body as String = Request.GetBody()

    ' Extract title from JSON (simple parsing)
    var title as String = "Untitled"
    var titleStart as Integer = Str.IndexOf(body, "\"title\"")
    if titleStart >= 0 then
        var colonPos as Integer = Str.IndexOf(Str.Substring(body, titleStart, Str.Length(body) - titleStart), ":")
        if colonPos >= 0 then
            var afterColon as String = Str.Substring(body, titleStart + colonPos + 1, Str.Length(body) - titleStart - colonPos - 1)
            var quoteStart as Integer = Str.IndexOf(afterColon, "\"")
            if quoteStart >= 0 then
                var rest as String = Str.Substring(afterColon, quoteStart + 1, Str.Length(afterColon) - quoteStart - 1)
                var quoteEnd as Integer = Str.IndexOf(rest, "\"")
                if quoteEnd >= 0 then
                    title = Str.Substring(rest, 0, quoteEnd)
                end if
            end if
        end if
    end if

    ' Create new task
    var taskId as Integer = nextTaskId
    nextTaskId = nextTaskId + 1

    var task as String = "{\"id\": " + taskId + ", \"title\": \"" + title + "\", \"completed\": false}"
    tasks[taskId] = task

    Response.SetContentType("application/json")
    Response.SetStatus(201)
    Response.Write(task)
end sub

' DELETE /api/tasks/{id} - Delete task
sub HandleDeleteTask()
    var idStr as String = Request.GetPathParam("id")
    var id as Integer = 0

    for i = 0 to Str.Length(idStr) - 1
        var c as String = Str.Substring(idStr, i, 1)
        if c >= "0" and c <= "9" then
            id = id * 10 + (Str.CharAt(c, 0) - 48)
        end if
    next i

    Response.SetContentType("application/json")

    if id < 1 or id >= nextTaskId or Str.Length(tasks[id]) = 0 then
        Response.SetStatus(404)
        Response.Write("{\"error\": \"Task not found\"}")
    else
        tasks[id] = ""
        Response.SetStatus(204)
    end if
end sub

' GET / - Welcome page
sub HandleRoot()
    Response.SetContentType("text/html")
    Response.Write("<html><head><title>JVM BASIC API</title></head><body>")
    Response.Write("<h1>JVM BASIC 2.0 REST API</h1>")
    Response.Write("<h2>Available Endpoints:</h2>")
    Response.Write("<ul>")
    Response.Write("<li><code>GET /api/tasks</code> - List all tasks</li>")
    Response.Write("<li><code>GET /api/tasks/{id}</code> - Get task by ID</li>")
    Response.Write("<li><code>POST /api/tasks</code> - Create task (JSON body with 'title')</li>")
    Response.Write("<li><code>DELETE /api/tasks/{id}</code> - Delete task</li>")
    Response.Write("</ul>")
    Response.Write("<h2>Examples:</h2>")
    Response.Write("<pre>")
    Response.Write("curl http://localhost:8080/api/tasks\n")
    Response.Write("curl -X POST http://localhost:8080/api/tasks -d '{\"title\":\"Buy milk\"}'\n")
    Response.Write("curl http://localhost:8080/api/tasks/1\n")
    Response.Write("curl -X DELETE http://localhost:8080/api/tasks/1\n")
    Response.Write("</pre>")
    Response.Write("</body></html>")
end sub

' Main program
Console.WriteLine("==============================================")
Console.WriteLine("   JVM BASIC 2.0 REST API Server")
Console.WriteLine("==============================================")
Console.WriteLine("")

var server as Integer = WebServer.Create(8080)

' Register routes
var r1 as Integer = WebServer.AddRoute(server, "GET", "/", "ApiServer", "HandleRoot")
var r2 as Integer = WebServer.AddRoute(server, "GET", "/api/tasks", "ApiServer", "HandleListTasks")
var r3 as Integer = WebServer.AddRoute(server, "GET", "/api/tasks/{id}", "ApiServer", "HandleGetTask")
var r4 as Integer = WebServer.AddRoute(server, "POST", "/api/tasks", "ApiServer", "HandleCreateTask")
var r5 as Integer = WebServer.AddRoute(server, "DELETE", "/api/tasks/{id}", "ApiServer", "HandleDeleteTask")

Console.WriteLine("Routes registered:")
Console.WriteLine("  GET  /              - Welcome page")
Console.WriteLine("  GET  /api/tasks     - List all tasks")
Console.WriteLine("  GET  /api/tasks/{id} - Get task by ID")
Console.WriteLine("  POST /api/tasks     - Create task")
Console.WriteLine("  DELETE /api/tasks/{id} - Delete task")
Console.WriteLine("")

var started as Integer = WebServer.Start(server)
Console.WriteLine("Server running on http://localhost:8080")
Console.WriteLine("Press Ctrl+C to stop")
Console.WriteLine("")

WebServer.Join(server)
